flowchart TB
  subgraph Coupon["优惠券业务"]
    C1["游客领取"] --> C2["校验发布状态、有效期、库存与个人上限"]
    C2 --> C3["保存本人券码与来源识别"]
    C3 --> C4["所属商户提交券码"]
    C4 --> C5{"已核销"}
    C5 -->|是| C6["返回原核销结果"]
    C5 -->|否| C7["保存核销时间与人员<br/>写服务端统计"]
  end
  subgraph Quest["寻迹业务"]
    Q1["加入已发布有效路线"] --> Q2["按节点选择真实凭据"]
    Q2 --> Q3["识字: 本人确认请求<br/>扫码: 指定token<br/>围栏: GCJ-02当前位置<br/>核销: 加入后使用的券<br/>人工: 运营确认"]
    Q3 --> Q4["后端判定条件<br/>同一用户节点只保留一个印记"]
    Q4 --> Q5{"全部节点完成"}
    Q5 -->|否| Q2
    Q5 -->|是| Q6["路线完成与奖励领取"]
    Q6 -->|暂缺奖励| Q7["保留完成记录<br/>可重试发奖"]
    Q7 --> Q6
    Q6 --> Q8["印记海报与分享"]
  end
  C7 --> Q3

