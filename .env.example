# Local development. Copy to .env and keep actual secrets out of Git.
DONGBA_ENVIRONMENT=development
DONGBA_DATABASE_URL=mysql+pymysql://dongba:CHANGE_ME@127.0.0.1:3307/dongba?charset=utf8mb4
# Optional independent MySQL schema. Empty disables RAG without blocking recognition.
DONGBA_RAG_DATABASE_URL=
DONGBA_AUTO_CREATE_SCHEMA=true
DONGBA_SETUP_ENABLED=true
DONGBA_SETUP_SECRET=
DONGBA_SESSION_HOURS=24
DONGBA_PUBLIC_BASE_URL=http://127.0.0.1:8010
DONGBA_MEDIA_DIRECTORY=runtime/media
# Optional deployable DB1404 multi-prototype bundle; missing/invalid bundles fall back safely.
DONGBA_GLYPH_PROTOTYPE_DIRECTORY=runtime/glyph-prototype-bundle
# Trusted local DB1404 classifier. Keep the artifact outside Git and verify its digest.
DONGBA_LOCAL_MODEL_PATH=runtime/db1404-model/inference.pt
DONGBA_LOCAL_MODEL_SHA256=98e773677ce8df711991a92f41ba55177954cc0d2e36f25ab3a4eda29b5fef89
DONGBA_LOCAL_MODEL_VERSION=db1404-cpu-v2-20261010
DONGBA_LOCAL_MODEL_THREADS=2
DONGBA_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# Use db1404-local for local CPU inference; use volcengine-ark for manual rollback.
DONGBA_PROVIDER_NAME=unconfigured
DONGBA_PROVIDER_ENDPOINT=
DONGBA_PROVIDER_API_KEY=
DONGBA_PROVIDER_MODEL=
DONGBA_WECHAT_APP_ID=
DONGBA_WECHAT_APP_SECRET=
DONGBA_PRIVACY_POLICY_PUBLISHED=false
DONGBA_PRIVACY_CONTACT=
DONGBA_PRIVACY_VERSION=2026-09-23
DONGBA_RETENTION_DAYS=30
DONGBA_DICTIONARY_PATH=data/characters.json
DONGBA_MAX_IMAGE_BYTES=8388608
DONGBA_MAX_IMAGE_PIXELS=20000000
DONGBA_PROVIDER_TIMEOUT_SECONDS=15

# SHARE-01: separate OpenAI-compatible Images API (runtime admin overrides supported).
# Use a public HTTPS Base URL or complete /v1/images/generations endpoint.
# Do not put real API keys in this example or any client bundle.
DONGBA_IMAGE_PROVIDER_NAME=unconfigured
DONGBA_IMAGE_PROVIDER_ENDPOINT=
DONGBA_IMAGE_PROVIDER_MODEL=
DONGBA_IMAGE_PROVIDER_API_KEY=
DONGBA_IMAGE_PROVIDER_TIMEOUT_SECONDS=180
DONGBA_IMAGE_PROVIDER_SIZE=1024x1536
DONGBA_IMAGE_PROVIDER_QUALITY=auto
# Persistent Fernet master key is server-only, required for encrypted admin key storage.
DONGBA_SYSTEM_CONFIG_ENCRYPTION_KEY=
