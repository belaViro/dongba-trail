# Local development. Copy to .env and keep actual secrets out of Git.
DONGBA_ENVIRONMENT=development
DONGBA_DATABASE_URL=mysql+pymysql://dongba:CHANGE_ME@127.0.0.1:3307/dongba?charset=utf8mb4
DONGBA_AUTO_CREATE_SCHEMA=true
DONGBA_SETUP_ENABLED=true
DONGBA_SETUP_SECRET=
DONGBA_SESSION_HOURS=24
DONGBA_PUBLIC_BASE_URL=http://127.0.0.1:8010
DONGBA_MEDIA_DIRECTORY=runtime/media
DONGBA_TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]

# User will configure the provider later; implement the adapter in provider_factory.py.
DONGBA_PROVIDER_NAME=unconfigured
DONGBA_PROVIDER_ENDPOINT=
DONGBA_PROVIDER_API_KEY=
DONGBA_PROVIDER_MODEL=
DONGBA_WECHAT_APP_ID=
DONGBA_WECHAT_APP_SECRET=
DONGBA_PRIVACY_POLICY_PUBLISHED=false
DONGBA_PRIVACY_CONTACT=
DONGBA_PRIVACY_VERSION=2026-09-23
DONGBA_RETENTION_DAYS=30
DONGBA_DICTIONARY_PATH=data/characters.json
DONGBA_MAX_IMAGE_BYTES=8388608
DONGBA_MAX_IMAGE_PIXELS=20000000
DONGBA_PROVIDER_TIMEOUT_SECONDS=15
