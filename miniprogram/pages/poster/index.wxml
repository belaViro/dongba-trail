<view class="page"><view class="page-title">我的东巴印记</view><view class="muted">留住属于你的丽江记忆</view><view-state loading="{{loading}}" error="{{!items.length ? error : ''}}" empty="{{!items.length}}" empty-text="先识别或收藏一个东巴字" bind:retry="load" /><block wx:if="{{items.length}}">
<image wx:if="{{image}}" class="poster-image" src="{{image}}" mode="widthFix" bindtap="preview" /><view wx:else class="poster-preview {{template}}"><view class="poster-brand">东巴寻迹 · 丽江</view><view class="poster-heading">我的东巴印记</view><view class="selected-glyphs"><block wx:for="{{items}}" wx:key="id"><view wx:if="{{item.selected}}" class="preview-word"><glyph-image src="{{item.image_url}}" name="{{item.cn_name}}" /><text>{{item.cn_name}}</text></view></block><text wx:if="{{!selected.length}}" class="muted">选择旅途中遇见的东巴字</text></view><view class="poster-footer">一字一故事，一程一印记</view></view>
<view wx:if="{{image && !shareCode}}" class="notice">当前海报暂未包含小程序码</view><view wx:if="{{error}}" class="notice error-note">{{error}}</view>
<view class="section"><view class="section-head"><text class="heading">选择东巴字</text><text class="caption">{{selected.length}} / 3</text></view><view class="word-grid"><view wx:for="{{items}}" wx:key="id" class="word-item {{item.selected ? 'selected' : ''}}" data-id="{{item.id}}" bindtap="toggle"><view class="word-image"><glyph-image src="{{item.image_url}}" name="{{item.cn_name}}" /></view><text>{{item.cn_name}}</text><view wx:if="{{item.selected}}" class="tick">✓</view></view></view></view>
<view class="section"><view class="heading">海报模板</view><view class="templates"><view class="template paper {{template === 'paper' ? 'active' : ''}}" data-template="paper" bindtap="template"><view class="swatch swatch-paper"></view><text>纸笺</text></view><view class="template mountain {{template === 'mountain' ? 'active' : ''}}" data-template="mountain" bindtap="template"><view class="swatch swatch-mountain"></view><text>远山</text></view></view></view>
<button class="primary section" disabled="{{!selected.length || generating}}" loading="{{generating}}" bindtap="generate">{{image ? '重新生成' : '生成海报'}}</button><view wx:if="{{image}}" class="actions"><button class="secondary" loading="{{saving}}" disabled="{{saving}}" bindtap="save">保存海报</button><button class="secondary" open-type="share">分享好友</button></view></block></view>
