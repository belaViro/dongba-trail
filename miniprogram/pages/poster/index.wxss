.poster-page { min-height: 100vh; background: #f4f1eb; color: #342e28; }
.poster-page button { box-sizing: border-box; margin: 0; min-height: 44px; line-height: 1.45; font-size: 26rpx; font-weight: 400; }
.poster-page button::after { border: 0; }
.poster-page button[size="mini"] { box-sizing: border-box; display: flex; align-items: center; justify-content: center; width: auto; max-width: 100%; margin: 0; min-height: 44px; line-height: 1.45; font-size: 26rpx; }
.poster-page .selected-glyph[size="mini"], .poster-page .word-item[size="mini"], .poster-page .template[size="mini"] { width: 100%; }
.poster-page .quiet-button[size="mini"] { padding: 0 10rpx; }
.poster-page .swap-button[size="mini"] { padding: 0 18rpx; }
.poster-page .selected-glyph[size="mini"] { padding: 38rpx 10rpx 24rpx; }
.poster-page .word-item[size="mini"] { padding: 12rpx 6rpx; }
.poster-page .template[size="mini"] { padding: 0; }
.poster-page .poster-actions button[size="mini"] { min-height: 52px; padding: 20rpx 14rpx; font-size: 30rpx; }
.poster-page .preview-button[size="mini"] { display: block; width: 100%; min-width: 44px; min-height: 44px; padding: 0; border: 0; border-radius: 12rpx; background: transparent; }
.poster-page button[disabled] { opacity: .55; }
.poster-hero { height: 530rpx; position: relative; overflow: hidden; background: #dbe4e6; }
.poster-landscape, .hero-wash { position: absolute; width: 100%; height: 100%; top: 0; left: 0; }
.poster-landscape { z-index: 0; }
.hero-wash { z-index: 1; }
.hero-copy, .hero-signature { z-index: 2; }
.hero-wash { background: linear-gradient(180deg, rgba(239,247,248,.72), rgba(247,249,244,.12) 52%, rgba(246,241,232,.28)); }
.hero-copy { position: relative; padding: 44rpx 34rpx 0; text-align: center; }
.hero-eyebrow { font-size: 18rpx; letter-spacing: 5rpx; color: #53636b; }
.hero-title { margin-top: 12rpx; font-family: 'Songti SC', 'SimSun', serif; font-size: 48rpx; font-weight: 700; letter-spacing: 5rpx; color: #233944; }
.hero-subtitle { display: block; font-size: 24rpx; margin-top: 16rpx; color: #364b53; }
.hero-signature { position: absolute; right: 34rpx; bottom: 78rpx; display: flex; align-items: center; gap: 18rpx; transform: rotate(-5deg); font-family: 'Songti SC', serif; font-size: 34rpx; line-height: 1.6; color: #663c29; text-align: right; white-space: pre-line; text-shadow: 0 1px 8px #fff; }
.hero-seal { width: 30rpx; padding: 6rpx 3rpx; border: 1px solid #ad3426; border-radius: 5rpx; font-size: 22rpx; line-height: 1.15; color: #ad3426; text-align: center; text-shadow: none; }
.poster-sheet { position: relative; margin-top: -34rpx; padding: 4rpx 30rpx 28rpx; padding-bottom: calc(28rpx + env(safe-area-inset-bottom)); border-radius: 34rpx 34rpx 0 0; background: #fffdfa; }
.editor-section { padding: 26rpx 0 30rpx; border-bottom: 1rpx solid #eee8df; }
.section-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; min-height: 44px; margin-bottom: 18rpx; }
.step-title { display: flex; align-items: center; gap: 12rpx; font-size: 31rpx; font-weight: 600; min-width: 0; }
.step-number { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 38rpx; height: 38rpx; border-radius: 50%; background: #ac3025; color: #fff; font-size: 25rpx; font-family: Georgia, serif; font-weight: 400; }
.selection-count { color: #827a71; font-size: 24rpx; font-weight: 400; white-space: nowrap; }
.poster-page .quiet-button { background: transparent; border: 0; color: #77716a; padding: 0 10rpx; min-width: 44px; flex-shrink: 0; }
.selected-glyphs { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14rpx; }
.poster-page .selected-glyph { position: relative; display: flex; flex-direction: column; align-items: center; border: 1rpx solid #eaddcc; border-radius: 16rpx; background: #f3ebdf; padding: 38rpx 10rpx 24rpx; min-width: 0; color: #453b30; }
.glyph-order { position: absolute; left: 14rpx; top: 10rpx; font-size: 21rpx; color: #9b8771; }
.glyph-remove { position: absolute; right: 12rpx; top: 10rpx; display: flex; align-items: center; justify-content: center; width: 32rpx; height: 32rpx; border-radius: 50%; background: #b13327; color: #fff; font-size: 28rpx; }
.selected-image { width: 100%; height: 142rpx; }
.selected-name { margin-top: 18rpx; font-family: 'Songti SC', serif; font-size: 32rpx; overflow-wrap: anywhere; }
.selection-empty { min-height: 150rpx; display: flex; align-items: center; justify-content: center; gap: 18rpx; border: 1rpx dashed #daccb9; border-radius: 16rpx; font-size: 24rpx; color: #8b7b66; background: #faf6ef; }
.empty-mark { font-family: serif; color: #bc9c83; font-size: 44rpx; }
.gallery-heading { display: flex; justify-content: space-between; align-items: center; margin: 26rpx 0 18rpx; font-size: 25rpx; color: #60564b; }
.gallery-note { font-size: 21rpx; color: #8b8277; font-weight: 400; }
.gallery-scroll { max-height: 370rpx; height: 310rpx; }
.word-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; padding-bottom: 8rpx; }
.poster-page .word-item { position: relative; display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 12rpx 6rpx; border: 1rpx solid #ebe5dc; border-radius: 12rpx; background: #fbf8f3; color: #50473e; }
.poster-page .word-item.is-selected { border-color: #af3527; background: #fcf0e5; }
.gallery-order { position: absolute; right: 5rpx; top: 3rpx; font-size: 19rpx; color: #ab3025; }
.word-image { width: 100%; height: 74rpx; }
.word-name { display: block; width: 100%; margin-top: 8rpx; overflow: hidden; white-space: nowrap; text-overflow: ellipsis; font-family: serif; font-size: 25rpx; }
.missing-glyph { color: #998b78; font-size: 18rpx; }
.minor-title { font-size: 29rpx; font-weight: 600; }
.templates { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 12rpx; }
.poster-page .template { display: flex; flex-direction: column; align-items: center; min-width: 0; padding: 0; background: transparent; color: #5a5045; border: 0; }
.swatch { box-sizing: border-box; width: 100%; height: 180rpx; position: relative; display: flex; align-items: center; justify-content: center; border: 2rpx solid #e5dacc; border-radius: 12rpx; }
.swatch-paper { background: linear-gradient(135deg, #f9eed9, #e9d9bd); color: #997752; }
.swatch-mountain { background: linear-gradient(155deg, #f1f6f5, #cadadd); color: #55727b; }
.swatch-old-town { background: linear-gradient(135deg, #f2e6d8, #d9b9a1); color: #8a5f47; }
.swatch-minimal { background: #f5f4f0; color: #5c5b54; }
.swatch-mark { font-family: 'Songti SC', serif; font-size: 45rpx; opacity: .82; }
.is-active .swatch { border-color: #af3325; box-shadow: 0 4rpx 12rpx rgba(118,54,31,.08); }
.style-check { position: absolute; right: 7rpx; top: 7rpx; width: 30rpx; height: 30rpx; line-height: 30rpx; border-radius: 50%; background: #ad3025; color: #fff; font-size: 21rpx; }
.template-name { margin-top: 13rpx; font-size: 24rpx; white-space: nowrap; }
.is-active .template-name { color: #a53125; font-weight: 600; }
.template-detail { font-size: 19rpx; color: #938575; margin-top: 5rpx; white-space: nowrap; }
.poster-page .swap-button { border: 1rpx solid #e4cbb6; border-radius: 999rpx; background: #fffaf4; color: #8b4a2c; padding: 0 18rpx; min-width: 88px; flex-shrink: 0; }
.caption-box { position: relative; border: 1rpx solid #e8e0d5; border-radius: 16rpx; background: #fdfbf8; padding: 22rpx 22rpx 48rpx; }
.caption-input { box-sizing: border-box; width: 100%; height: 116rpx; min-height: 68px; font-size: 29rpx; line-height: 1.65; color: #4b433a; padding: 0; }
.caption-counter { position: absolute; bottom: 14rpx; right: 20rpx; font-size: 22rpx; color: #938c83; }
.preview-section { border-bottom: 0; padding-bottom: 20rpx; }
.preview-label { border: 1rpx solid #e8ddcc; border-radius: 99rpx; padding: 6rpx 14rpx; color: #8c755c; font-size: 21rpx; white-space: nowrap; }
.poster-image { display: block; width: 100%; min-height: 44px; border-radius: 12rpx; box-shadow: 0 8rpx 28rpx rgba(69,44,25,.1); }
.draft-preview { padding: 28rpx 22rpx 20rpx; border: 1rpx solid #e4d9c8; border-radius: 14rpx; text-align: center; background: #f7eee0; }
.draft-mountain { background: #edf2f1; }
.draft-old-town { background: #f3e7dc; }
.draft-minimal { background: #f7f6f2; }
.draft-brand { font-size: 20rpx; letter-spacing: 4rpx; color: #8b755d; }
.draft-glyphs { display: flex; justify-content: center; align-items: flex-start; gap: 18rpx; min-height: 126rpx; padding: 26rpx 0 18rpx; }
.draft-word { width: 28%; min-width: 0; font-size: 27rpx; font-family: serif; overflow-wrap: anywhere; }
.draft-image { height: 86rpx; width: 100%; margin-bottom: 12rpx; }
.draft-empty { font-size: 25rpx; color: #9a8a77; padding: 26rpx 0; }
.draft-caption { display: block; white-space: pre-wrap; overflow-wrap: anywhere; font-family: 'Songti SC', serif; font-size: 27rpx; line-height: 1.8; }
.draft-label { display: block; margin-top: 20rpx; font-size: 20rpx; color: #978976; }
.generation-state { display: flex; align-items: center; justify-content: center; gap: 14rpx; color: #8c4e33; font-size: 25rpx; padding: 26rpx 0 4rpx; }
.progress-dot { flex-shrink: 0; width: 12rpx; height: 12rpx; background: #ae3427; border-radius: 50%; }
.poster-error { margin-top: 22rpx; padding: 20rpx 22rpx; border-radius: 12rpx; background: #fff1eb; color: #923f2b; font-size: 25rpx; line-height: 1.65; overflow-wrap: anywhere; }
.regeneration-note { display: block; margin-top: 14rpx; color: #8c755c; font-size: 22rpx; line-height: 1.6; }
.poster-actions { display: flex; gap: 18rpx; padding-top: 14rpx; }
.poster-actions button { flex: 1; min-width: 0; min-height: 52px; padding: 20rpx 14rpx; border: 0; border-radius: 18rpx; font-size: 30rpx; font-weight: 600; }
.poster-page .generate-button, .poster-page .share-button { color: #fffaf4; background: #af2c20; }
.poster-page .save-button { color: #803e25; background: #f2e8dc; }
.page-signoff { display: block; text-align: center; color: #a09382; font-size: 21rpx; letter-spacing: 2rpx; padding: 28rpx 0 10rpx; }
