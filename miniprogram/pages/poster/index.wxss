.poster-image{display:block;width:100%;border-radius:10rpx;margin-top:30rpx;box-shadow:0 16rpx 32rpx rgba(65,50,35,.12)}
.poster-preview{padding:38rpx 26rpx;margin-top:32rpx;min-height:580rpx;display:flex;flex-direction:column;align-items:center;justify-content:space-between;border:1rpx solid #d2bda5;border-radius:8rpx;box-shadow:0 16rpx 34rpx rgba(65,50,35,.1)}
.paper{background:linear-gradient(145deg,#fffaf0,#eadbc5)}.mountain{background:linear-gradient(155deg,#fffaf0 35%,#d8e1d8 72%,#9aada2)}
.poster-brand{font-size:22rpx;align-self:flex-start;color:#934532;letter-spacing:2rpx}.poster-heading{font-family:serif;font-size:48rpx;margin:24rpx 0 30rpx;font-weight:700;color:#3d3026}
.selected-glyphs{display:flex;gap:14rpx;align-items:center;justify-content:center;min-height:210rpx;max-width:100%;width:100%}.preview-word{display:flex;flex-direction:column;align-items:center;gap:15rpx;width:30%;min-width:0;font-size:30rpx}.preview-word glyph-image{width:100%;height:150rpx}.poster-footer{font-size:25rpx;margin-top:35rpx;color:#934532}
.word-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx}.word-item{position:relative;display:flex;flex-direction:column;align-items:center;gap:15rpx;padding:20rpx 14rpx;border:2rpx solid #d9cdbb;background:#fffdf8;border-radius:14rpx;overflow-wrap:anywhere;min-width:0;text-align:center}.word-item.selected{border-color:#a73529;background:#fff0e8}.word-image{height:120rpx;width:100%}.tick{position:absolute;top:8rpx;right:8rpx;background:#a73529;color:#fff;border-radius:50%;height:32rpx;width:32rpx;line-height:32rpx;font-size:22rpx}
.templates{display:flex;gap:20rpx;margin-top:24rpx}.template{display:flex;gap:16rpx;align-items:center;padding:16rpx 22rpx;border:2rpx solid #d8cbb9;border-radius:14rpx;flex:1;background:#fffdf8}.template.active{border-color:#a73529}.swatch{width:42rpx;height:52rpx;border:1rpx solid #cbbda9}.swatch-paper{background:#f4e1c6}.swatch-mountain{background:linear-gradient(145deg,#e4e8df,#8da496)}
