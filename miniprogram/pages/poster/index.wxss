.poster-image{display:block;width:100%;border-radius:8rpx;margin-top:30rpx}.poster-preview{padding:38rpx 26rpx;margin-top:32rpx;min-height:580rpx;display:flex;flex-direction:column;align-items:center;justify-content:space-between;border:1rpx solid #d7e2da}.paper{background:#fafbf8}.mountain{background:#e9f2ed}.poster-brand{font-size:22rpx;align-self:flex-start;color:#55745f}.poster-heading{font-size:44rpx;margin:24rpx 0 30rpx;font-weight:700}.selected-glyphs{display:flex;gap:14rpx;align-items:center;justify-content:center;min-height:210rpx;max-width:100%;width:100%}.preview-word{display:flex;flex-direction:column;align-items:center;gap:15rpx;width:30%;min-width:0;font-size:30rpx}.preview-word glyph-image{width:100%;height:150rpx}.poster-footer{font-size:25rpx;margin-top:35rpx;color:#6f8574}.word-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18rpx}.word-item{position:relative;display:flex;flex-direction:column;align-items:center;gap:15rpx;padding:20rpx 14rpx;border:2rpx solid #dce5df;background:#fff;border-radius:10rpx;overflow-wrap:anywhere;min-width:0;text-align:center}.word-item.selected{border-color:#176b58;background:#edf5ee}.word-image{height:120rpx;width:100%}.tick{position:absolute;top:8rpx;right:8rpx;background:#176b58;color:#fff;border-radius:50%;height:32rpx;width:32rpx;line-height:32rpx;font-size:22rpx}.templates{display:flex;gap:20rpx;margin-top:24rpx}.template{display:flex;gap:16rpx;align-items:center;padding:16rpx 22rpx;border:2rpx solid #d8e3db;border-radius:10rpx;flex:1}.template.active{border-color:#176b58}.swatch{width:42rpx;height:52rpx;border:1rpx solid #cbd9cd}.swatch-paper{background:#fafbf8}.swatch-mountain{background:#bdd9c7}
