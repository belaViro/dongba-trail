.result-image{width:100%;height:330rpx;background:#e8efea;border-radius:12rpx}.candidate{display:flex;align-items:center;gap:20rpx;padding:24rpx 18rpx;border:2rpx solid #dde7df;border-radius:12rpx;background:#fff;margin-top:18rpx}.candidate.selected{border-color:#176b58;background:#f0f7f0}.candidate-glyph{width:94rpx;height:94rpx;flex-shrink:0}.score{display:flex;flex-direction:column;align-items:center;gap:5rpx;font-size:24rpx;flex-shrink:0}.score radio{transform:scale(.8)}
