.result-page{padding-top:20rpx}.result-title-row{display:flex;justify-content:space-between;align-items:flex-start;padding:10rpx 0 24rpx}.result-title-row .page-title{margin:0}.result-mark{width:52rpx;height:52rpx;border-radius:50%;border:2rpx solid #b73b2d;color:#b73b2d;text-align:center;line-height:48rpx;font-weight:700}.result-image{width:100%;height:360rpx;background:#e8efea;border-radius:24rpx;box-shadow:0 12rpx 24rpx rgba(57,55,41,.12)}.result-notice{display:flex;gap:18rpx;align-items:flex-start;margin-top:28rpx;padding:26rpx 22rpx;background:#fff0df;border-radius:22rpx;border:1rpx solid #eed8bf}.notice-icon{display:flex;width:48rpx;height:48rpx;align-items:center;justify-content:center;border-radius:50%;background:#c8753a;color:#fff;font-size:32rpx;font-weight:700;flex-shrink:0}.notice-title{font-size:31rpx;color:#713617;font-weight:700;margin-bottom:8rpx}.candidate{display:flex;align-items:center;gap:20rpx;padding:24rpx 18rpx;border:2rpx solid #e5e1d8;border-radius:18rpx;background:#fffdf9;margin-top:18rpx}.candidate.selected{border-color:#bd3025;background:#fff1ed;box-shadow:0 8rpx 18rpx rgba(189,48,37,.12)}.candidate-glyph{width:112rpx;height:112rpx;flex-shrink:0;background:#f5eee4;border-radius:14rpx}.score{display:flex;flex-direction:column;align-items:center;gap:5rpx;font-size:24rpx;flex-shrink:0;color:#b52f24}.score radio{transform:scale(.8)}.integration-note{margin:34rpx 10rpx 10rpx;text-align:center;color:#8a8d88;font-size:22rpx;line-height:1.6}
