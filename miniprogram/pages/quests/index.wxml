<view class="quests-page">
  <image class="quest-landscape" src="/assets/home/landscape.jpg" mode="aspectFill" aria-hidden="true" />
  <view class="landscape-fade"></view>
  <view class="quest-nav" style="padding-top:{{heroTop}}px"><text>寻迹任务</text></view>

  <view class="journey-paper">
    <image class="paper-grain" src="/assets/home/paper.png" mode="scaleToFill" aria-hidden="true" />
    <view class="paper-content">
      <view class="journey-heading">
        <view class="title-ribbon"><text>古城寻迹</text></view>
        <view class="journey-brand"><image src="/assets/home/brand.png" mode="aspectFit" aria-label="东巴寻迹 · 丽江" /><text>一字一印 · 一路丽江</text></view>
      </view>
      <view class="journey-subtitle">走进古城街巷，收集属于你的东巴印记</view>

      <view class="journey-toolbar">
        <view class="journey-tabs">
          <button class="journey-tab {{filter === 'all' ? 'is-active' : ''}}" data-type="all" bindtap="filter">全部路线</button>
          <button class="journey-tab {{filter === 'mine' ? 'is-active' : ''}}" data-type="mine" bindtap="filter">我的寻迹</button>
        </view>
        <button class="album-link" bindtap="stamps">印记册 <text>›</text></button>
      </view>

      <view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="{{filter === 'mine' ? '还没有加入路线，去全部路线开启旅程吧' : '寻迹路线正在准备中，晚些时候再来看看'}}" bind:retry="load" />
      <block wx:if="{{!loading && !error && items.length}}">
        <scroll-view wx:if="{{items.length > 1}}" class="route-picker" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
          <button wx:for="{{items}}" wx:key="id" class="route-choice {{selectedId === item.id ? 'is-selected' : ''}}" data-id="{{item.id}}" bindtap="selectRoute">{{item.name}}</button>
        </scroll-view>
        <view-state loading="{{featureLoading}}" error="{{featureError}}" bind:retry="retryFeature" />
        <block wx:if="{{feature && !featureLoading && !featureError}}">
          <view class="route-caption"><text class="route-caption-title">{{feature.item.name}}</text><text class="route-caption-area">{{feature.item.area || '丽江'}}</text></view>

          <view wx:if="{{feature.total}}" class="stamp-orbit {{feature.compact ? 'is-grid' : feature.dense ? 'is-dense' : feature.sparse ? 'is-sparse' : ''}}">
            <view class="orbit-dash" aria-hidden="true"></view>
            <view class="orbit-center">
              <text class="progress-label">{{feature.complete ? '本程已完成' : '已收集印记'}}</text>
              <view class="progress-number"><text>{{feature.completed}}</text><text class="progress-slash">/</text>{{feature.total}}</view>
              <view class="center-rule"></view>
              <text class="center-note">{{feature.complete ? '走过的风景，都在印记里' : '循着文字，慢慢读懂丽江'}}</text>
              <image class="center-mountains" src="/assets/home/ink-mountain.png" mode="aspectFit" aria-hidden="true" />
            </view>
            <button wx:for="{{feature.nodes}}" wx:key="id" class="orbit-node {{item.completed ? 'is-done' : item.is_next ? 'is-next' : 'is-pending'}}" style="{{feature.compact ? '' : item.orbit_style}}" bindtap="continueQuest" aria-label="{{item.name + (item.completed ? '，已收集' : '，查看任务')}}">
              <view class="stamp-face"><text class="stamp-sequence">{{item.number}}</text><image class="stamp-icon" src="{{item.glyph_url || item.icon}}" data-id="{{item.id}}" data-kind="glyph_url" binderror="mediaFailed" mode="aspectFit" /><view class="stamp-state">{{item.completed ? '✓' : item.is_next ? '›' : '·'}}</view></view>
              <text class="stamp-label">{{item.glyph_name || item.condition_name}}</text>
            </button>
          </view>
          <view wx:else class="nodes-preparing"><image src="/assets/home/scroll.png" mode="aspectFit" /><text>沿途任务正在准备中</text><text class="nodes-preparing-hint">先看看路线介绍，下一段旅程即将开启</text></view>

          <view class="orbit-legend"><text class="legend-dot done-dot"></text><text>已收集</text><text class="legend-dot next-dot"></text><text>下一站</text><text class="legend-dot pending-dot"></text><text>待探索</text></view>
          <view wx:if="{{feature.closed}}" class="route-notice">这条路线暂未开放，已收集的印记仍为你保留。</view>
          <view class="discovery-cards">
            <view class="next-card">
              <view class="card-eyebrow">{{feature.complete ? '旅程纪念' : '下一目标'}}</view>
              <view class="next-card-body">
                <view class="next-art"><image src="{{feature.next ? (feature.next.glyph_url || feature.next.icon) : '/assets/home/scroll.png'}}" data-id="{{feature.next.id}}" data-kind="glyph_url" binderror="mediaFailed" mode="aspectFit" /></view>
                <view class="next-copy"><text class="next-title">{{feature.next ? feature.next.name : feature.complete ? '一路风景，尽在印记' : '等待新的相遇'}}</text><text class="next-hint">{{feature.next ? feature.next.action_hint : feature.complete ? '打开印记册，收藏这段旅程' : '沿途任务正在准备中'}}</text></view>
              </view>
              <button wx:if="{{feature.next}}" class="next-link" bindtap="continueQuest">{{feature.closed ? '查看任务' : '去寻找'}} <text>›</text></button>
              <button wx:else class="next-link" bindtap="stamps">我的印记册 <text>›</text></button>
            </view>
            <view class="reward-card">
              <view class="reward-heading"><image src="/assets/home/bag.png" mode="aspectFit" /><text>寻迹礼遇</text></view>
              <text class="reward-condition">{{feature.progress.reward_claim_id ? '完成奖励已领取' : feature.progress.reward_pending ? '完成奖励待领取' : feature.item.reward_coupon_id ? '完成整条路线后可领取' : '把旅途收进印记册'}}</text>
              <text class="reward-title">{{rewardTitle || (feature.item.reward_coupon_id ? (rewardUnavailable ? '奖励详情暂不可用' : '正在读取奖励…') : '每一次相遇，都值得收藏')}}</text>
              <image class="reward-art" src="/assets/home/scroll.png" mode="aspectFit" aria-hidden="true" />
              <button class="reward-link" bindtap="continueQuest">{{feature.item.reward_coupon_id ? '查看奖励' : '路线详情'}} <text>›</text></button>
            </view>
          </view>

          <view class="itinerary-card">
            <view class="itinerary-heading"><view><text class="section-title">沿途寻迹</text><text class="section-subtitle">跟着印记走，遇见古城里的故事</text></view><button class="map-link" bindtap="map">文化地图 <text>›</text></button></view>
            <scroll-view wx:if="{{feature.total}}" class="itinerary-scroll" scroll-x="{{true}}" enable-flex="{{true}}" show-scrollbar="{{false}}">
              <button class="stop-card {{item.completed ? 'stop-done' : ''}}" wx:for="{{feature.nodes}}" wx:key="id" bindtap="continueQuest">
                <view class="stop-art"><image wx:if="{{item.place_image}}" class="stop-photo" src="{{item.place_image}}" data-id="{{item.id}}" data-kind="place_image" binderror="mediaFailed" mode="aspectFill" /><image wx:else src="{{item.icon}}" mode="aspectFit" /><text>{{item.completed ? '已收集' : item.is_next ? '下一站' : item.condition_name}}</text></view>
                <view class="stop-name"><text class="stop-number">{{index + 1}}</text><text>{{item.name}}</text></view>
                <text class="stop-action">{{item.condition_name}}任务 <text>›</text></text>
              </button>
            </scroll-view>
            <text wx:if="{{feature.item.description}}" class="route-description">{{feature.item.description}}</text>
          </view>
          <button class="journey-primary" bindtap="continueQuest"><image src="/assets/tabs/stamp-active.png" mode="aspectFit" /><view><text class="primary-label">{{feature.action_label}}</text><text class="primary-hint">{{feature.complete ? '重温一路收集的东巴印记' : feature.closed ? '查看沿途任务与已收集的印记' : '去遇见下一段古城故事'}}</text></view><text class="primary-arrow">›</text></button>
        </block>
      </block>
      <view class="journey-footer"><text></text><view>走过丽江 · 留下印记</view><text></text></view>
    </view>
  </view>
</view>
