<view class="page"><view class="row between"><view><view class="page-title">东巴寻迹</view><view class="muted">把丽江的故事，留在旅途里</view></view><button class="small secondary" bindtap="stamps">我的印记</button></view><view class="tabs section"><button class="{{filter === 'all' ? 'active' : ''}}" data-type="all" bindtap="filter">全部路线</button><button class="{{filter === 'mine' ? 'active' : ''}}" data-type="mine" bindtap="filter">我的寻迹</button></view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="{{filter === 'mine' ? '尚未加入寻迹路线' : '寻迹路线正在准备中'}}" bind:retry="load" /><view wx:if="{{!loading}}" class="quest-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="row between"><text class="area">{{item.area || '丽江'}}</text><text wx:if="{{item.progress}}" class="tag">{{item.progress.status === 'completed' ? '已完成' : '寻迹中'}}</text></view><view class="quest-name">{{item.name}}</view><view class="body muted">{{item.description}}</view><view class="row between section"><text class="caption">{{item.end_date ? '截止 ' + item.end_date : ''}}</text><text class="continue">{{item.progress ? '已获得 ' + item.completed + ' 枚印记' : '开启寻迹'}} ›</text></view></view></view>
