<view class="page"><view class="page-title">我的东巴印记</view><view class="muted">每一枚，都是旅途的足迹</view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="完成寻迹任务，收集第一枚印记" bind:retry="load" /><view class="stamp-list" wx:if="{{!loading}}"><view wx:for="{{items}}" wx:key="id" class="stamp" data-id="{{item.quest_id}}" bindtap="detail"><view class="stamp-ring"><text>迹</text></view><view class="item-title">{{item.name || '寻迹印记'}}</view><view class="caption">{{item.date}}</view></view></view><button wx:if="{{items.length}}" class="primary section" bindtap="poster">制作旅行海报</button></view>
