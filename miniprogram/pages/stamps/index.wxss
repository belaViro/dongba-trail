.stamp-list{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:32rpx;margin-top:35rpx}.stamp{text-align:center;padding:20rpx 4rpx}.stamp-ring{width:142rpx;height:142rpx;border:3rpx solid #a05b4a;outline:1rpx solid #a05b4a;outline-offset:-9rpx;border-radius:50%;margin:0 auto 24rpx;display:flex;align-items:center;justify-content:center;color:#a05b4a;font-size:46rpx}.stamp .item-title{font-size:27rpx}.stamp .caption{margin-top:8rpx}
