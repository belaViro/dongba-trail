/* MINI-01 / DESIGN-01: reference homepage; real data and native camera only. */
page { background: #f3f4f7; }
.home-page { position: relative; padding: 0 0 24rpx; min-height: 100vh; overflow: hidden; color: #30251f; background: #f3f4f7; }
.home-landscape, .landscape-wash { position: absolute; top: 0; left: 0; width: 100%; height: 820rpx; }
.landscape-wash { background: linear-gradient(180deg, rgba(245,250,255,.03) 0%, rgba(255,255,255,0) 65%, #f3f4f7 100%); }
.home-hero { position: relative; padding: 0 44rpx; }
.hero-stage { position: relative; height: 480rpx; }
.brand-row { display: flex; align-items: center; gap: 8rpx; width: 410rpx; max-width: 68%; }
.brand-art { display: block; width: 370rpx; height: 72rpx; flex: 1; min-width: 0; }
.hero-seal { display: flex; flex-direction: column; justify-content: center; align-items: center; width: 25rpx; height: 48rpx; flex-shrink: 0; background: #b3271c; color: #fff5e3; border-radius: 6rpx 3rpx 6rpx 2rpx; font-family: KaiTi, STKaiti, serif; font-size: 18rpx; line-height: 1.18; transform: rotate(-3deg); box-shadow: inset 0 0 0 2rpx rgba(255,238,211,.18); }
.slogan { font-family: KaiTi, STKaiti, serif; font-size: 23rpx; letter-spacing: 1rpx; line-height: 1.6; color: #202b37; margin-top: 2rpx; }
.hero-rule { height: 4rpx; width: 94rpx; margin: 12rpx 0 14rpx 92rpx; background: #a9251b; border-radius: 70% 20% 60% 30%; transform: rotate(-3deg); }
.hero-note { position: relative; z-index: 4; display: flex; flex-direction: column; width: 275rpx; font-family: KaiTi, STKaiti, serif; font-size: 21rpx; color: #38302c; line-height: 1.45; letter-spacing: 1rpx; }
.hero-inscription { position: absolute; right: -12rpx; top: 65rpx; display: flex; flex-direction: row-reverse; gap: 6rpx; font-family: KaiTi, STKaiti, serif; color: #293b41; font-size: 19rpx; line-height: 1.2; }
.hero-inscription > text { width: 22rpx; word-break: break-all; }
.hero-inscription > text:nth-child(2) { margin-top: 26rpx; }
.inscription-seal { position: absolute; bottom: -28rpx; left: 2rpx; padding: 3rpx; border-radius: 4rpx; color: #fff2d6; background: #a6281e; font-size: 14rpx; }
.recognize { position: absolute; bottom: 10rpx; left: 50%; z-index: 3; transform: translateX(-50%); width: 270rpx; height: 270rpx; min-height: 0; padding: 30rpx 8rpx 22rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; border-radius: 50%; border: 3rpx solid rgba(184,243,255,.95); color: #fff; background: radial-gradient(ellipse at 27% 12%, rgba(130,239,255,.66), transparent 57%), linear-gradient(140deg, #49b5e8 8%, #398cdd 58%, #1e56c1); box-shadow: inset 0 0 14rpx rgba(213,252,255,.9), inset -6rpx -12rpx 30rpx rgba(15,62,171,.26), 0 0 5rpx 2rpx #8ce9ff, 0 0 0 13rpx rgba(240,250,255,.55), 0 0 0 28rpx rgba(245,250,255,.32), 0 0 0 42rpx rgba(235,245,250,.12), 0 15rpx 36rpx rgba(19,57,88,.4); }
.recognize::before { content: ""; position: absolute; top: -28rpx; right: -28rpx; bottom: -28rpx; left: -28rpx; border: 2rpx solid rgba(255,255,255,.65); border-radius: 50%; pointer-events: none; }
.recognize { width: 300rpx; height: 300rpx; overflow: visible; }
.camera-mark { display: block; width: 98rpx; height: 86rpx; margin-bottom: 12rpx; }
.camera-title { font-size: 31rpx; font-weight: 700; letter-spacing: 1rpx; line-height: 1.5; }
.camera-sub { font-size: 21rpx; line-height: 1.5; font-weight: 400; margin-top: 4rpx; }
.album-shortcut { position: absolute; right: 2rpx; bottom: 46rpx; z-index: 4; display: flex; flex-direction: column; align-items: center; justify-content: center; width: 112rpx; height: 112rpx; min-height: 112rpx; padding: 0; border-radius: 50%; color: #24506e; background: rgba(255,255,255,.92); box-shadow: 0 6rpx 18rpx rgba(31,58,84,.22), inset 0 0 0 2rpx rgba(120,170,210,.5); font-size: 20rpx; line-height: 1.4; }
.album-shortcut-icon { font-size: 36rpx; line-height: 1.1; }
.home-content { position: relative; padding: 0 24rpx; }
.home-state { position: relative; z-index: 2; }
.daily-card { position: relative; z-index: 2; margin-top: -12rpx; overflow: hidden; border-radius: 22rpx; padding: 24rpx 26rpx 26rpx; background: #fcf3e4; box-shadow: 0 8rpx 28rpx rgba(97,75,44,.05); }
.paper-texture { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: .8; }
.ink-mountain { position: absolute; right: -8rpx; bottom: 0; width: 270rpx; height: 160rpx; opacity: .36; }
.daily-header { position: relative; display: flex; justify-content: space-between; align-items: flex-start; gap: 12rpx; }
.daily-heading { display: block; color: #35251b; font-size: 29rpx; font-weight: 700; line-height: 1.5; }
.daily-date { display: block; color: #6b594b; font-size: 20rpx; line-height: 1.6; }
/* DESIGN-01: readable reference pill, with a separate 52px-high touch area. */
.daily-header .daily-detail[size="mini"] { position: relative; display: flex; flex: 0 0 148rpx; width: 148rpx; min-width: 148rpx; max-width: 148rpx; height: 52px; min-height: 52px; margin: -10rpx -6rpx 0 0; padding: 0; align-items: center; justify-content: center; background: transparent; color: #874426; font-size: 21rpx; font-weight: 500; line-height: 1; white-space: nowrap; gap: 7rpx; }
.daily-detail::before { content: ""; position: absolute; box-sizing: border-box; left: 6rpx; right: 6rpx; top: 50%; height: 42rpx; transform: translateY(-50%); border: 1rpx solid #e5d4bc; border-radius: 40rpx; background: rgba(255,255,255,.48); }
.daily-detail text { position: relative; }
.detail-arrow { font-size: 28rpx; }
/* Keep the invisible hit area rectangular; only the visible pill is rounded. */
.daily-header .daily-detail[size="mini"], .discoveries-actions .more-button[size="mini"] { border-radius: 0; }
/* DESIGN-01: use a view for layout; native v2 button sizing must not center this row. */
.today { position: relative; width: 100%; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 22rpx; margin: 18rpx 0 0; padding: 0; background: transparent; text-align: left; font-weight: 400; border-radius: 0; }
.daily-glyph-frame { display: block; width: 176rpx; height: 176rpx; flex: 0 0 176rpx; padding: 14rpx; overflow: hidden; border-radius: 20rpx; background: #fff; box-shadow: 0 4rpx 14rpx rgba(96,72,39,.06); }
.daily-glyph { display: block; width: 100%; height: 100%; }
.daily-copy { flex: 1 1 0%; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; text-align: left; }
.daily-name-row { display: flex; width: 100%; align-items: center; justify-content: flex-start; gap: 12rpx; margin-bottom: 10rpx; text-align: left; }
.daily-name { max-width: 65%; font-family: KaiTi, STKaiti, serif; font-size: 38rpx; font-weight: 700; line-height: 1.4; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.daily-category { flex-shrink: 0; max-width: 45%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; color: #9d5a29; border: 1rpx solid #dfb98e; border-radius: 22rpx; padding: 0 12rpx; font-size: 18rpx; line-height: 1.6; background: rgba(255,248,231,.72); }
.daily-summary { width: 100%; color: #7c7063; font-size: 23rpx; font-weight: 400; line-height: 1.65; text-align: left; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
.daily-empty { position: relative; min-height: 112rpx; display: flex; align-items: center; color: #7c7063; font-size: 24rpx; }
.quick-nav { display: flex; gap: 12rpx; margin-top: 16rpx; }
.quick-nav button { position: relative; flex: 1; min-width: 0; min-height: 44px; height: 114rpx; display: flex; flex-direction: row; align-items: center; justify-content: flex-start; gap: 10rpx; padding: 18rpx 10rpx; border-radius: 18rpx; background: rgba(255,255,255,.9); box-shadow: 0 6rpx 20rpx rgba(62,77,92,.025); }
.nav-symbol { display: flex; align-items: center; justify-content: center; width: 60rpx; height: 66rpx; border-radius: 14rpx; flex-shrink: 0; }
.nav-symbol image { width: 46rpx; height: 46rpx; }
.nav-map .nav-symbol { background: #e0f0f0; }
.nav-quest .nav-symbol { background: #faead7; }
.nav-shop .nav-symbol { background: #f8e2e7; }
.nav-copy { flex: 1; min-width: 0; text-align: left; }
.nav-name { display: block; white-space: nowrap; font-size: 23rpx; color: #31251e; line-height: 1.5; font-weight: 600; }
.nav-map .nav-name { color: #163e48; }
.nav-caption { display: flex; align-items: center; gap: 3rpx; font-size: 17rpx; color: #82817e; font-weight: 400; line-height: 1.7; white-space: nowrap; }
.nav-caption > text:first-child { overflow: hidden; text-overflow: ellipsis; }
.nav-arrow { display: flex; align-items: center; justify-content: center; flex-shrink: 0; width: 17rpx; height: 17rpx; background: #f0ede9; border-radius: 50%; font-size: 23rpx; line-height: 1; color: #9a8e84; }
.discoveries { margin-top: 20rpx; }
.discoveries-header { display: flex; align-items: center; justify-content: space-between; min-height: 74rpx; gap: 8rpx; }
.discoveries-title { display: flex; align-items: center; gap: 12rpx; color: #30241e; font-size: 29rpx; font-weight: 700; white-space: nowrap; }
.discoveries-title image { width: 29rpx; height: 36rpx; }
.discoveries-actions { display: flex; align-items: center; }
.locate-button { width: 44px; height: 44px; padding: 12px; min-height: 44px; background: transparent; opacity: .7; }
.locate-button image { width: 20px; height: 20px; }
.locate-button.is-located { background: #e4efeb; border-radius: 50%; opacity: 1; }
.discoveries-actions .more-button[size="mini"] { display: flex; flex: 0 0 148rpx; width: 148rpx; min-width: 148rpx; max-width: 148rpx; height: 52px; min-height: 52px; margin: 0; padding: 0 12rpx; align-items: center; justify-content: center; gap: 6rpx; color: #888887; background: transparent; font-size: 23rpx; font-weight: 400; line-height: 1; white-space: nowrap; }
.more-button text { font-size: 34rpx; line-height: 1; }
.location-note { margin: 0 0 12rpx; color: #866957; font-size: 21rpx; line-height: 1.5; }
.merchant-scroll { width: calc(100% + 24rpx); }
.merchant-track { display: flex; align-items: stretch; gap: 16rpx; padding: 0 24rpx 16rpx 0; }
.merchant-card { display: block; position: relative; flex-shrink: 0; width: 304rpx; padding: 0; overflow: hidden; text-align: left; color: #30251f; background: #fff; border-radius: 18rpx; font-weight: 400; box-shadow: 0 6rpx 22rpx rgba(68,79,90,.025); }
.merchant-cover { height: 184rpx; position: relative; overflow: hidden; background: #ece8e2; }
.merchant-cover > image { display: block; width: 100%; height: 100%; }
.merchant-placeholder { display: flex; flex-direction: column; gap: 6rpx; align-items: center; justify-content: center; height: 100%; background: linear-gradient(135deg, #f1ebe1, #e3ddd2); color: #8f8071; font-size: 18rpx; }
.merchant-placeholder image { width: 50rpx; height: 50rpx; opacity: .55; }
.distance { position: absolute; left: 12rpx; top: 10rpx; display: flex; align-items: center; gap: 5rpx; padding: 1rpx 10rpx 2rpx 7rpx; color: #fff; background: rgba(33,30,25,.76); border-radius: 32rpx; font-size: 19rpx; line-height: 1.5; }
.distance image { width: 18rpx; height: 22rpx; }
.merchant-body { padding: 14rpx 14rpx 18rpx; }
.merchant-name { color: #35271f; font-size: 23rpx; line-height: 1.5; font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.merchant-tags { display: flex; align-items: center; gap: 5rpx; min-height: 34rpx; overflow: hidden; white-space: nowrap; }
.merchant-tag { flex-shrink: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; padding: 0 8rpx; border-radius: 24rpx; background: #f3ede5; color: #856146; font-size: 17rpx; line-height: 1.6; }
.merchant-footer { display: flex; justify-content: flex-end; align-items: center; margin-top: 8rpx; }
.merchant-cta { display: block; border-radius: 32rpx; padding: 3rpx 18rpx; background: linear-gradient(110deg, #d49c73, #a75235); color: #fff; font-size: 20rpx; line-height: 1.6; }
.merchant-empty { padding: 34rpx 20rpx; border-radius: 18rpx; background: #fff; color: #7b756d; font-size: 24rpx; }
@media (max-width: 350px) { .nav-symbol { width: 52rpx; } .quick-nav button { gap: 8rpx; padding-left: 9rpx; padding-right: 9rpx; } .nav-name { font-size: 22rpx; } }
