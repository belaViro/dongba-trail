.home-page{padding-top:22rpx}.home-hero{position:relative;overflow:hidden;padding:14rpx 6rpx 34rpx;min-height:650rpx;border-radius:28rpx;background:linear-gradient(180deg,#b9d9ec 0%,#f8f1e6 70%)}.hero-cover,.hero-wash{position:absolute;inset:0;width:100%;height:100%}.hero-cover{opacity:.58;filter:saturate(.84)}.hero-wash{background:linear-gradient(180deg,rgba(246,241,232,.12),rgba(246,241,232,.96) 74%)}.home-hero:after{content:"";position:absolute;right:-90rpx;top:130rpx;width:260rpx;height:260rpx;border-radius:50%;border:1rpx solid rgba(164,93,74,.16);box-shadow:0 0 0 22rpx rgba(164,93,74,.04),0 0 0 44rpx rgba(164,93,74,.025)}.hero-top,.home-hero>.brand,.home-hero>.slogan,.hero-note,.recognize{position:relative;z-index:1}.hero-top{display:flex;align-items:center;justify-content:space-between}.location{color:#8f3c2f;font-size:24rpx;font-weight:600;margin:10rpx 0}.hero-mark{width:54rpx;height:54rpx;border:2rpx solid #ad604d;border-radius:50%;display:flex;align-items:center;justify-content:center;color:#ad604d;font-size:28rpx;font-weight:700}.slogan{color:#4e5e59;margin-top:10rpx;font-size:27rpx}.hero-note{width:70%;margin-top:28rpx;color:#394943;font-size:25rpx;line-height:1.7}.recognize{margin-top:60rpx;background:linear-gradient(145deg,#56baf0,#2567d7);color:white;display:flex;flex-direction:column;align-items:center;justify-content:center;padding:42rpx 28rpx;border-radius:999rpx;width:420rpx;height:420rpx;margin-left:auto;margin-right:auto;box-shadow:0 18rpx 34rpx rgba(37,103,215,.28),0 0 0 16rpx rgba(255,255,255,.52),0 0 0 24rpx rgba(36,104,201,.16)}.camera-mark{height:52rpx;width:68rpx;border:4rpx solid #e5f5ee;border-radius:10rpx;position:relative;margin:8rpx 0 24rpx}.camera-mark:before{content:"";position:absolute;top:-13rpx;left:18rpx;width:28rpx;height:12rpx;border:4rpx solid #e5f5ee;border-bottom:0;border-radius:4rpx 4rpx 0 0}.camera-mark view{width:23rpx;height:23rpx;border:4rpx solid #e5f5ee;border-radius:50%;margin:11rpx auto}.camera-title{font-size:36rpx}.camera-sub{font-size:23rpx;color:#d9f0ff;margin-top:10rpx;font-weight:400}.quick-nav{display:flex;justify-content:space-around;padding:28rpx 12rpx 30rpx;border-bottom:1rpx solid #e0d9ce;background:rgba(255,253,248,.78);border-radius:0 0 22rpx 22rpx}.quick-nav>view{display:flex;flex-direction:column;align-items:center;gap:6rpx;font-size:25rpx;color:#345247}.nav-symbol{font-size:40rpx;color:#b34031;height:56rpx;line-height:56rpx}.nav-caption{color:#8b958d;font-size:20rpx}.section-card{padding:26rpx 24rpx;background:rgba(255,253,248,.9);border:1rpx solid #e7dfd2;border-radius:22rpx;box-shadow:0 10rpx 24rpx rgba(63,67,52,.06)}.eyebrow{display:block;color:#a45d4a;font-size:19rpx;letter-spacing:3rpx;font-weight:700;margin-bottom:4rpx}.today{padding:18rpx 0 4rpx}.daily-glyph{width:135rpx;height:135rpx;flex-shrink:0;background:#f2ecdf;border-radius:18rpx}.daily-name{font-size:40rpx;font-weight:700;margin-bottom:6rpx;color:#284338}
