<view class="page home-page">
  <view class="home-hero">
    <image wx:if="{{merchants.length && merchants[0].image_url}}" class="hero-cover" src="{{merchants[0].image_url}}" mode="aspectFill" />
    <view class="hero-wash"></view>
    <view class="hero-top"><view class="location">云南 · 丽江</view><view class="hero-mark">迹</view></view>
    <view class="brand">东巴寻迹</view><view class="slogan">在一笔一画间，遇见丽江</view>
    <view class="hero-note">看见一个字，也看见它身后的山河、手艺与人。</view>
    <button class="recognize" bindtap="camera"><view class="camera-mark"><view></view></view><text class="camera-title">拍照识东巴</text><text class="camera-sub">点击即拍摄 · 看见字里的丽江</text></button>
  </view>
  <feature-note label="待接入" detail="首页专属风景图尚无后台配置入口，当前借用商户配图；拍摄中的实时清晰度、光线提示尚未实现。" />
  <view class="quick-nav"><view bindtap="map"><text class="nav-symbol">⌖</text><text>东巴地图</text><text class="nav-caption">文化点位</text></view><view bindtap="quests"><text class="nav-symbol">✦</text><text>寻迹任务</text><text class="nav-caption">边走边集章</text></view><view bindtap="catalog"><text class="nav-symbol">◇</text><text>丽江好物</text><text class="nav-caption">手作与风物</text></view></view>
  <view-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <block wx:if="{{!loading && !error}}">
    <view class="section section-card"><view class="section-head"><view><text class="eyebrow">DAILY GLYPH</text><text class="heading">今日东巴字</text></view><text class="caption">一字一故事</text></view>
      <view wx:if="{{today}}" class="today row" bindtap="character"><view class="daily-glyph"><glyph-image src="{{today.image_url}}" name="{{today.cn_name}}" /></view><view class="grow"><view class="daily-name">{{today.cn_name}}</view><view class="muted">{{today.culture_summary}}</view></view><text class="chevron">›</text></view>
      <view wx:else class="empty-inline">东巴字内容正在整理中</view>
    </view>
    <view class="section"><view class="section-head"><view><text class="eyebrow">LOCAL PICKS</text><text class="heading">丽江发现</text></view><button class="link small" bindtap="more">全部 ›</button></view>
      <view wx:for="{{merchants}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="merchant"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.address}}</view><view><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view></view><text class="caption">{{item.distance}}</text></view>
      <view wx:if="{{!merchants.length}}" class="empty-inline">已审核的文化商户将在这里展示</view>
    </view>
  </block>
</view>
