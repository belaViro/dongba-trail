<view class="page bottom-space">
  <view-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <block wx:if="{{item && !loading}}">
    <view class="character-header"><view class="hero-glyph" data-src="{{item.image_url}}" bindtap="preview"><glyph-image src="{{item.image_url}}" name="{{item.cn_name}}" /></view><view class="category">{{item.category_l1}}<text wx:if="{{item.category_l2}}"> / {{item.category_l2}}</text></view><view class="word">{{item.cn_name}}</view><view class="summary">{{item.culture_summary}}</view></view>
    <button wx:if="{{recognitionId}}" class="link small section" bindtap="correct">识别不对？</button>
    <view class="section" wx:if="{{item.variants.length}}"><view class="section-head"><text class="heading">这个字怎么写</text><text class="caption">{{item.variants.length}} 种写法</text></view><scroll-view scroll-x class="variants"><view class="variant" wx:for="{{item.variants}}" wx:key="image_url" data-src="{{item.image_url}}" bindtap="preview"><glyph-image src="{{item.image_url}}" /><text class="caption">{{item.source_ref}}</text></view></scroll-view></view>
    <view class="section"><view class="heading">东巴文化里的含义</view><view class="body section">{{item.culture_detail || item.culture_summary}}</view><view class="caption section">内容来源：{{item.source_ref}}</view></view>
    <button wx:if="{{item.audio_url}}" class="audio section" bindtap="audio"><text>{{playing ? 'Ⅱ' : '▷'}}</text><text>听东巴先生讲</text><text class="caption">{{playing ? '正在播放' : '文化音频'}}</text></button>
    <view class="section" wx:if="{{related.length}}"><view class="heading">相关东巴字</view><view class="tabs"><button wx:for="{{related}}" wx:key="id" data-id="{{item.id}}" bindtap="related">{{item.cn_name}}</button></view></view>
    <view class="section"><view class="section-head"><text class="heading">在丽江遇见它</text><button class="link small" bindtap="nearby">全部 ›</button></view><view wx:for="{{merchants}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="merchant"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.address}}</view></view><text class="caption">{{item.distance}}</text></view><view wx:if="{{!merchants.length}}" class="empty-inline">暂未关联文化地点</view></view>
    <view class="section" wx:if="{{products.length}}"><view class="heading">相关好物</view><view wx:for="{{products}}" wx:key="id" class="list-row" data-id="{{item.merchant_id}}" bindtap="merchant"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="price">¥ {{item.price}}</view></view></view></view>
    <button class="secondary section" bindtap="quests">加入寻迹</button>
    <view class="bottom-bar"><button class="secondary" disabled="{{favoriteBusy}}" bindtap="favorite">{{saved ? '已收藏' : '收藏'}}</button><button class="primary" bindtap="share">生成东巴印记</button></view>
  </block>
</view>
