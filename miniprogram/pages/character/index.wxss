.character-header{position:relative;text-align:center;padding:44rpx 0 48rpx;border-bottom:1rpx solid #e3d9ca;overflow:hidden;background:linear-gradient(145deg,#f8f0e2,#e7f0ed)}.character-backdrop{position:absolute;inset:0;background:radial-gradient(circle at 80% 15%,rgba(100,170,210,.25),transparent 38%),linear-gradient(180deg,rgba(255,255,255,.2),rgba(255,255,255,.78));}.hero-glyph,.character-header>.category,.character-header>.word,.character-header>.summary{position:relative;z-index:1}.hero-glyph{width:280rpx;height:250rpx;margin:0 auto 28rpx;background:#efe1c9;border-radius:22rpx;box-shadow:0 12rpx 25rpx rgba(75,50,26,.16);padding:16rpx}.category{color:#9c513d;font-size:24rpx}.word{font-size:64rpx;font-weight:700;margin:8rpx 0 18rpx;color:#182f3f}.summary{font-size:29rpx;color:#567061;line-height:1.9;padding:0 20rpx}.variants{white-space:nowrap;margin-top:24rpx}.variant{display:inline-flex;flex-direction:column;width:185rpx;height:240rpx;margin-right:22rpx;white-space:normal;vertical-align:top;padding:16rpx;background:#fffdf8;border-radius:16rpx}.variant glyph-image{height:170rpx;flex-shrink:0}.variant text{margin-top:12rpx;display:block}.audio{display:flex;align-items:center;gap:24rpx;justify-content:space-between;background:#f7e9d8;color:#76371e}.audio>text:first-child{font-size:36rpx}.audio .caption{font-weight:400}.integration-note{padding:18rpx 22rpx;background:#f4e9dc;color:#8b634a;border-radius:14rpx;font-size:23rpx;line-height:1.6}
