.character-header{text-align:center;padding:28rpx 0 40rpx;border-bottom:1rpx solid #dce5de}.hero-glyph{width:280rpx;height:250rpx;margin:0 auto 28rpx}.category{color:#8c6c58;font-size:24rpx}.word{font-size:64rpx;font-weight:700;margin:8rpx 0 18rpx}.summary{font-size:29rpx;color:#567061;line-height:1.9;padding:0 20rpx}.variants{white-space:nowrap;margin-top:24rpx}.variant{display:inline-flex;flex-direction:column;width:185rpx;height:240rpx;margin-right:22rpx;white-space:normal;vertical-align:top}.variant glyph-image{height:170rpx;flex-shrink:0}.variant text{margin-top:12rpx;display:block}.audio{display:flex;align-items:center;gap:24rpx;justify-content:space-between;background:#e5eee7}.audio>text:first-child{font-size:36rpx}.audio .caption{font-weight:400}
