<view class="page"><view class="row between"><text class="page-title">我的收藏</text><button wx:if="{{items.length}}" class="secondary small" bindtap="poster">制作海报</button></view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="还没有收藏的东巴字" bind:retry="load" /><view wx:if="{{!loading}}" class="list-row" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="detail"><view class="thumb"><glyph-image src="{{item.image_url}}" name="{{item.cn_name}}" /></view><view class="grow"><view class="item-title">{{item.cn_name}}</view><view class="muted">{{item.culture_summary}}</view></view><button class="link small" data-id="{{item.id}}" disabled="{{!!busy}}" loading="{{busy === item.id}}" catchtap="remove">取消收藏</button></view></view>
