<view class="page bottom-space"><view-state loading="{{loading}}" error="{{error}}" bind:retry="load" /><block wx:if="{{item && !loading}}"><image wx:if="{{item.image_url}}" class="cover" src="{{item.image_url}}" mode="aspectFill" /><view class="section page-title">{{item.name}}</view><view><text wx:for="{{item.tags}}" wx:key="*this" class="tag">{{item}}</text></view><view class="body section">{{item.description}}</view><view class="section"><view class="list-row"><text class="muted">地址</text><text class="grow">{{item.address}}</text></view><view class="list-row"><text class="muted">营业</text><text>{{item.opening_hours || '暂未提供'}}</text></view><view wx:if="{{item.phone}}" class="list-row" bindtap="call"><text class="muted">联系</text><text class="grow">{{item.phone}}</text><text class="chevron">›</text></view></view>
<feature-note label="待实现" detail="商户评分、月销量尚无后台字段及统计接口，不展示参考图中的示例数值。" />
<view class="section"><view class="section-head"><text class="heading">到店礼遇</text><button class="link small" bindtap="wallet">我的优惠券 ›</button></view><view class="coupon" wx:for="{{coupons}}" wx:key="id"><view class="grow"><view class="item-title">{{item.title}}</view><view class="muted">{{item.rule}}</view><view class="caption">有效期至 {{item.end_date}}</view></view><button class="primary small" data-id="{{item.id}}" disabled="{{!!claiming}}" loading="{{claiming === item.id}}" bindtap="claim">领取</button></view><view wx:if="{{!coupons.length}}" class="empty-inline">暂无可领取优惠券</view></view>
<view class="section" wx:if="{{products.length}}"><view class="heading">店内好物</view><view class="list-row" wx:for="{{products}}" wx:key="id"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="price">¥ {{item.price}}</view></view></view></view>
<view class="section" wx:if="{{activities.length}}"><view class="heading">文化活动</view><view wx:for="{{activities}}" wx:key="id" class="list-row"><view><view class="item-title">{{item.name}}</view><view class="body">{{item.description}}</view><view class="caption">{{item.start_date}} 至 {{item.end_date}} · 名额 {{item.capacity}}</view></view></view></view>
<view class="bottom-bar"><button wx:if="{{item.phone}}" class="secondary" bindtap="call">联系商户</button><button class="primary" bindtap="navigate">去这里</button></view></block></view>
