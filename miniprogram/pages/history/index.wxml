<view class="page"><view class="row between"><text class="page-title">识别历史</text><button wx:if="{{items.length}}" class="link small danger" loading="{{deleting}}" disabled="{{deleting}}" bindtap="clear">清空</button></view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="还没有识别记录" bind:retry="load" /><view wx:if="{{!loading}}" class="list-row" wx:for="{{items}}" wx:key="request_id" data-id="{{item.request_id}}" bindtap="detail"><view wx:if="{{item.image_url}}" class="thumb"><glyph-image src="{{item.image_url}}" name="{{item.name}}" /></view><view class="grow"><view class="item-title">{{item.name}}</view><view class="caption">{{item.date}}</view></view><text class="tag">{{item.confirmed_character_id ? '已确认' : '查看结果'}}</text><text class="chevron">›</text></view></view>
