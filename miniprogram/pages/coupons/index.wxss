.coupon{padding:30rpx 28rpx;margin:24rpx 0;background:#fff;border:1rpx solid #dae5dc;border-left:7rpx solid #176b58;border-radius:12rpx}.coupon .body{margin-top:18rpx}.coupon .heading{font-size:32rpx}
.code-mask{position:fixed;inset:0;background:rgba(18,36,28,.48);z-index:20}.code-sheet{position:fixed;left:0;right:0;bottom:0;z-index:21;background:#fff;padding:30rpx 36rpx calc(40rpx + env(safe-area-inset-bottom));border-radius:16rpx 16rpx 0 0;text-align:center}.code-sheet .heading{text-align:left;font-size:32rpx}.code-image{width:380rpx;height:380rpx;max-width:100%;margin:15rpx auto 26rpx;display:flex;align-items:center;justify-content:center}.code-image image{height:100%;width:100%}.code-value{font-size:29rpx;word-break:break-all;color:#274d38;margin-bottom:12rpx}.close-code{background:transparent;font-size:44rpx;font-weight:400;flex-shrink:0}
