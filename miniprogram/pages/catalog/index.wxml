<view class="page"><view class="page-title">丽江好物</view><view class="row section"><input class="input grow" placeholder="搜索文创、饮食与手作" value="{{search}}" bindinput="search" bindconfirm="load" confirm-type="search" /><button class="secondary small" bindtap="load">搜索</button></view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="暂无已发布的好物" bind:retry="load" /><view wx:if="{{!loading}}" wx:for="{{items}}" wx:key="id" class="list-row" data-id="{{item.merchant_id}}" bindtap="merchant"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.description}}</view><view class="price">¥ {{item.price}}</view></view><text class="chevron">›</text></view></view>
