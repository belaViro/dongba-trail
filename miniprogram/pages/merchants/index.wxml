<view class="page"><view class="page-title">{{characterId ? '在丽江遇见它' : '丽江文化商户'}}</view><view class="row section"><input class="input grow" placeholder="搜索店名或文化主题" value="{{search}}" bindinput="search" bindconfirm="load" confirm-type="search" /><button class="small secondary" bindtap="load">搜索</button></view><button class="link section" bindtap="locate">{{location ? '更新当前位置' : '按当前位置查找'}}</button><view wx:if="{{locationError}}" class="notice">{{locationError}}</view><view-state loading="{{loading}}" error="{{error}}" empty="{{!items.length}}" empty-text="暂无符合条件的文化商户" bind:retry="load" /><view wx:if="{{!loading && !error}}" wx:for="{{items}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="detail"><image wx:if="{{item.image_url}}" class="thumb" src="{{item.image_url}}" mode="aspectFill" /><view class="grow"><view class="item-title">{{item.name}}</view><view class="muted">{{item.address}}</view><view><text wx:for="{{item.tags}}" wx:for-item="tag" wx:key="*this" class="tag">{{tag}}</text></view></view><text class="caption">{{item.distance}}</text></view></view>
