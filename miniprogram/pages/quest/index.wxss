.progress-band{padding:25rpx 0;border-top:1rpx solid #d9e5da;border-bottom:1rpx solid #d9e5da}.progress-band progress{margin:22rpx 0 8rpx}.complete{color:#176b58;font-size:26rpx;margin-top:18rpx}.node{display:flex;align-items:flex-start;gap:24rpx;padding:24rpx 0 30rpx;border-bottom:1rpx solid #e1e9e1}.number{width:64rpx;height:64rpx;flex-shrink:0;border-radius:50%;background:#e5eae5;display:flex;align-items:center;justify-content:center;color:#778d7c;font-size:26rpx;font-weight:700}.done .number{background:#176b58;color:#fff}.node-button{margin-top:20rpx;width:100%}
