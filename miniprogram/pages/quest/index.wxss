.route-eyebrow{font-size:23rpx;letter-spacing:3rpx;color:#a73529;margin-bottom:16rpx}.page-title{font-family:serif;color:#3d3026}
.progress-band{padding:28rpx;background:#fffaf0;border:1rpx solid #ddcbb3;border-radius:20rpx;box-shadow:0 8rpx 24rpx rgba(67,53,37,.05)}.progress-band .heading{font-size:52rpx;color:#a73529;font-family:serif}.progress-band progress{margin:22rpx 0 8rpx}.complete{color:#a73529;font-size:26rpx;margin-top:18rpx}
.node{position:relative;display:flex;align-items:flex-start;gap:24rpx;padding:28rpx 0 36rpx;border-bottom:1rpx dashed #dfd3c2}.number{width:68rpx;height:68rpx;flex-shrink:0;border-radius:50%;background:#efe5d6;display:flex;align-items:center;justify-content:center;color:#806546;font-size:27rpx;font-weight:700;border:3rpx double #cdb99b;box-shadow:0 0 0 6rpx #f9f4eb}.done .number{background:#a73529;border-color:#d69479;color:#fff}.node-button{margin-top:20rpx;width:100%}.node .row{flex-wrap:wrap;gap:6rpx}.node .tag{margin-top:4rpx}.done .item-title{color:#96503a}
