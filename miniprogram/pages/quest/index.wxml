<view class="page">
  <view-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
  <block wx:if="{{item && !loading}}">
    <view class="muted">{{item.area || '丽江'}}</view><view class="page-title">{{item.name}}</view>
    <view class="body section">{{item.description}}</view>
    <view wx:if="{{closed}}" class="notice">路线当前未开放，你已获得的印记和奖励记录会继续保留。</view>
    <view class="progress-band section">
      <view class="row between"><text class="heading">{{completed}} / {{nodes.length}}</text><text class="muted">枚东巴印记</text></view>
      <progress percent="{{percent}}" activeColor="#176b58" backgroundColor="#dce7dc" stroke-width="5" border-radius="5" />
      <view wx:if="{{progress && progress.status === 'completed'}}" class="complete">已完成本次寻迹</view>
    </view>
    <view wx:if="{{reward}}" class="notice" bindtap="wallet">已获得 {{reward.title}}，前往我的优惠券查看 ›</view>
    <view wx:if="{{item.reward_coupon_id && !reward && !progress.reward_pending}}" class="notice">完成全部节点后可获得路线奖励</view>
    <button wx:if="{{!progress}}" class="primary section" loading="{{busy === 'join'}}" disabled="{{!!busy || closed}}" bindtap="join">{{closed ? '路线暂未开放' : '加入寻迹'}}</button>
    <view wx:if="{{progress.reward_pending}}" class="notice">路线已完成，奖励正在补充中。<button class="link small" bindtap="retryReward" disabled="{{!!busy}}" loading="{{busy === 'reward'}}">重试领取奖励</button></view>
    <view class="section">
      <view class="section-head"><text class="heading">沿途印记</text><text class="caption">{{nodes.length}} 个节点</text></view>
      <view class="node {{item.completed ? 'done' : ''}}" wx:for="{{nodes}}" wx:key="id">
        <view class="number">{{item.completed ? '✓' : index + 1}}</view>
        <view class="grow">
          <view class="row between"><view class="item-title">{{item.name}}</view><text class="tag">{{item.condition_name}}</text></view>
          <button wx:if="{{item.merchant_id}}" class="link small" data-id="{{item.merchant_id}}" bindtap="merchant">查看任务地点 ›</button>
          <button wx:if="{{item.poi_id}}" class="link small" data-id="{{item.id}}" bindtap="navigateNode">导航至任务地点 ›</button>
          <button class="{{item.completed ? 'secondary' : 'primary'}} small node-button" data-id="{{item.id}}" bindtap="checkin" disabled="{{item.completed || !!busy || closed}}" loading="{{busy === item.id}}">{{item.completed ? '已获得' : item.condition === 'manual' ? '查看确认方式' : item.condition === 'recognition' ? '拍照识字' : item.condition === 'qr' ? '扫码打卡' : item.condition === 'coupon' ? '验证核销' : '到达打卡'}}</button>
        </view>
      </view>
      <view wx:if="{{!nodes.length}}" class="empty-inline">路线节点正在准备中</view>
    </view>
    <button wx:if="{{completed}}" class="secondary section" bindtap="share">生成我的东巴印记</button>
  </block>
</view>
