.profile-header{display:flex;align-items:center;gap:22rpx;padding:35rpx 0}.avatar{width:110rpx;height:110rpx;border-radius:50%;background:#e1ebdf;color:#427253;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:700;flex-shrink:0}.metrics{display:flex;padding:26rpx 0 36rpx;border-bottom:1rpx solid #d7e3d8}.metrics>view{flex:1;display:flex;flex-direction:column;align-items:center;font-size:25rpx;color:#7c8b7d}.metrics>view>text:first-child{font-size:42rpx;color:#244835;font-weight:700;margin-bottom:6rpx}.menu .list-row{padding:32rpx 0}
.identity{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #d7e3d8}.identity .grow{min-width:0}.identity-value{display:block;word-break:break-all;margin-top:8rpx;font-size:24rpx}.identity button{flex-shrink:0}
