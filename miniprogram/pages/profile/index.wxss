.profile-header{display:flex;align-items:center;gap:22rpx;padding:32rpx 0}.profile-header .heading{font-family:serif;font-size:34rpx;color:#3d3026}.avatar{width:110rpx;height:110rpx;border-radius:28rpx;background:#a73529;color:#fff3dc;border:5rpx double #d9a07f;display:flex;align-items:center;justify-content:center;font-family:serif;font-size:48rpx;font-weight:700;flex-shrink:0;box-shadow:0 8rpx 24rpx rgba(129,42,30,.12)}
.metrics{display:flex;padding:28rpx 0;background:#fffaf0;border:1rpx solid #dfcfb7;border-radius:20rpx}.metrics>view{flex:1;display:flex;flex-direction:column;align-items:center;font-size:25rpx;color:#756553}.metrics>view+view{border-left:1rpx solid #e5dac8}.metrics>view>text:first-child{font-size:42rpx;color:#a73529;font-weight:700;margin-bottom:6rpx}.menu{padding:0 24rpx;background:#fffdf8;border:1rpx solid #e5dac8;border-radius:20rpx;margin-top:24rpx}.menu .list-row{padding:30rpx 0}.menu .list-row:last-child{border-bottom:0}
.identity{display:flex;align-items:center;gap:20rpx;padding:26rpx 0;border-bottom:1rpx solid #e3d7c5}.identity .grow{min-width:0}.identity-value{display:block;word-break:break-all;margin-top:8rpx;font-size:24rpx}.identity button{flex-shrink:0}
