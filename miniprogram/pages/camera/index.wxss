page{background:#142e25}.camera-page{position:relative;height:calc(100vh - env(safe-area-inset-top));min-height:800rpx;background:#142e25;color:white}.camera,.preview{width:100%;height:100%;position:absolute;inset:0}.camera-top{position:absolute;top:48rpx;left:32rpx;right:32rpx;display:flex;align-items:center;flex-direction:column;text-shadow:0 1rpx 4rpx #142e25;font-size:32rpx;font-weight:600}.camera-hint{font-size:25rpx;font-weight:400;margin-top:12rpx}.frame{position:absolute;left:12%;right:12%;top:22%;height:42%}.corner{position:absolute;width:52rpx;height:52rpx;border-color:#f0faf4;border-style:solid;border-width:0}.c1{top:0;left:0;border-top-width:5rpx;border-left-width:5rpx}.c2{top:0;right:0;border-top-width:5rpx;border-right-width:5rpx}.c3{bottom:0;left:0;border-bottom-width:5rpx;border-left-width:5rpx}.c4{bottom:0;right:0;border-bottom-width:5rpx;border-right-width:5rpx}.camera-bottom{position:absolute;left:0;right:0;bottom:0;padding:28rpx 36rpx calc(64rpx + env(safe-area-inset-bottom));background:rgba(14,37,28,.86)}.capture-controls{display:flex;align-items:center;justify-content:space-between;gap:30rpx}.round-tool{background:transparent;color:#fff;font-size:26rpx;padding:18rpx;width:130rpx}.shutter{width:138rpx;height:138rpx;background:transparent;border:5rpx solid white;border-radius:50%;padding:10rpx;display:flex;align-items:center;justify-content:center}.shutter view{height:108rpx;width:108rpx;border-radius:50%;background:#fff}.camera-error{font-size:26rpx;margin-bottom:24rpx;text-align:center;color:#ffd8c5}.trace{font-size:20rpx;word-break:break-all;margin-top:8rpx}.privacy{background:transparent;color:#bed9c9;font-size:24rpx;font-weight:400}
.sample-options{margin-bottom:20rpx;padding-bottom:20rpx;border-bottom:1rpx solid #537165}.sample-consent,.sample-scene{display:flex;justify-content:space-between;align-items:center;gap:20rpx;font-size:26rpx}.sample-consent text{flex:1;min-width:0}.sample-consent switch{flex-shrink:0}.sample-scene{padding:12rpx 0;color:#d7e9df}.sample-purpose{font-size:22rpx;line-height:1.6;color:#c5d8cd;margin-top:8rpx}.camera-bottom{max-height:75%;overflow-y:auto}.preview{height:62%}
