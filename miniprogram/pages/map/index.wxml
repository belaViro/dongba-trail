<view class="map-page">
  <view class="map-intro"><text class="eyebrow">CULTURAL MAP</text><view class="map-title">跟着东巴字，走进丽江</view><view class="muted">一处地点，一段值得停留的故事</view></view>
  <view class="map-toolbar"><view class="tabs"><button data-type="all" class="{{filter === 'all' ? 'active' : ''}}" bindtap="filter">全部</button><button data-type="culture" class="{{filter === 'culture' ? 'active' : ''}}" bindtap="filter">文化点</button><button data-type="merchant" class="{{filter === 'merchant' ? 'active' : ''}}" bindtap="filter">商户</button><button data-type="quest" class="{{filter === 'quest' ? 'active' : ''}}" bindtap="filter">任务点</button></view></view>
  <map wx:if="{{center}}" id="culture-map" class="map" longitude="{{center.longitude}}" latitude="{{center.latitude}}" markers="{{markers}}" scale="15" show-location="{{!!location}}" bindmarkertap="marker" bindcallouttap="marker" />
  <view wx:else class="map-empty"><text>暂无可显示的文化地点</text></view>
  <view class="map-data-note">微信地图底图 · 点位坐标来自后台发布内容</view>
  <view class="page places-panel">
    <view class="row between"><view><text class="eyebrow">PLACES TO EXPLORE</text><view class="heading">文化地点</view></view><button class="small secondary" bindtap="locate">定位</button></view>
    <view wx:if="{{locationError}}" class="notice">{{locationError}}</view><view-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
    <view wx:if="{{selected}}" class="selected-place section"><text class="place-label">当前地点</text><view class="item-title">{{selected.name}}</view><view class="muted">{{selected.address || selected.description}}</view><view class="actions"><button wx:if="{{selected.merchant_id}}" class="secondary" bindtap="detail">查看商户</button><button class="primary" bindtap="navigate">去这里</button></view></view>
    <view wx:for="{{visiblePoints}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="select"><view class="place-number">{{index + 1}}</view><view class="grow"><view class="item-title">{{item.name}}</view><view class="caption">{{item.description}}</view></view><button class="small secondary" data-id="{{item.id}}" catchtap="navigate">导航</button></view>
    <view wx:if="{{!loading && !error && !visiblePoints.length}}" class="empty-inline">这个分类下还没有发布地点，试试其他分类。</view>
    <feature-note label="待接入" detail="地图路线连线与地图内优惠卡片尚未实现联动；现有点位、商户详情和导航已接入，优惠券可在商户详情领取。" />
  </view>
</view>
