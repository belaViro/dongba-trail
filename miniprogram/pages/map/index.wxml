<view class="map-page"><view class="map-toolbar"><view class="tabs"><button data-type="all" class="{{filter === 'all' ? 'active' : ''}}" bindtap="filter">全部</button><button data-type="culture" class="{{filter === 'culture' ? 'active' : ''}}" bindtap="filter">文化点</button><button data-type="merchant" class="{{filter === 'merchant' ? 'active' : ''}}" bindtap="filter">商户</button><button data-type="quest" class="{{filter === 'quest' ? 'active' : ''}}" bindtap="filter">任务点</button></view></view>
<map wx:if="{{center}}" id="culture-map" class="map" longitude="{{center.longitude}}" latitude="{{center.latitude}}" markers="{{markers}}" scale="15" show-location="{{!!location}}" bindmarkertap="marker" bindcallouttap="marker" />
<view wx:else class="map-empty"><text>暂无可显示的文化地点</text></view>
<view class="page"><view class="row between"><text class="heading">文化地点</text><button class="small secondary" bindtap="locate">定位</button></view><view wx:if="{{locationError}}" class="notice">{{locationError}}</view><view-state loading="{{loading}}" error="{{error}}" bind:retry="load" />
<view wx:if="{{selected}}" class="selected-place section"><view class="item-title">{{selected.name}}</view><view class="muted">{{selected.address || selected.description}}</view><view class="actions"><button wx:if="{{selected.merchant_id}}" class="secondary" bindtap="detail">查看商户</button><button class="primary" bindtap="navigate">去这里</button></view></view>
<view wx:for="{{visiblePoints}}" wx:key="id" class="list-row" data-id="{{item.id}}" bindtap="select"><view class="grow"><view class="item-title">{{item.name}}</view><view class="caption">{{item.description}}</view></view><button class="small secondary" data-id="{{item.id}}" catchtap="navigate">导航</button></view></view></view>
