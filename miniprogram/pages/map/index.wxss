.map-page{background:#f6f1e8;min-height:100vh}
.map-intro{padding:32rpx;background:linear-gradient(135deg,#f6f1e8,#ede3d4)}
.eyebrow{display:block;letter-spacing:3rpx;color:#ad382b;font-size:20rpx;font-weight:600}
.map-title{font-family:serif;font-size:40rpx;line-height:1.4;color:#28382f;margin:10rpx 0}
.map-toolbar{padding:8rpx 24rpx;background:#fffdf8;border-bottom:1rpx solid #e3ddd1}
.map-toolbar .tabs{flex-wrap:nowrap;justify-content:space-between}.map-toolbar button{flex:1;padding:14rpx 8rpx}
.map-toolbar .active{background:#a73529}.map{width:100%;height:540rpx}
.map-data-note{padding:12rpx 24rpx;background:#eee6da;color:#756a5d;font-size:22rpx;text-align:center}
.map-empty{height:380rpx;display:flex;align-items:center;justify-content:center;background:#e8eee9;color:#69776e;font-size:28rpx}
.places-panel{background:#fffdf8;border-radius:28rpx 28rpx 0 0;margin-top:18rpx}
.selected-place{padding:26rpx;background:#f5eee2;border:1rpx solid #e2d4c1;border-radius:18rpx;margin-top:24rpx}
.place-label{display:block;color:#a73529;font-size:22rpx;margin-bottom:10rpx}.place-number{display:flex;align-items:center;justify-content:center;width:46rpx;height:46rpx;flex-shrink:0;border:1rpx solid #d8c6ae;border-radius:50%;color:#995b3e;font-size:23rpx}
