.map-page { min-height: 100vh; padding-bottom: 28rpx; background: #f5f6f5; color: #262d32; font-family: -apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei",sans-serif; }
.map-intro { position: relative; overflow: hidden; padding: 12rpx 28rpx 14rpx; background: #edf2f4; }
.map-landscape { position: absolute; top: 0; left: 0; width: 100%; height: 100%; opacity: .25; }
.map-intro-content { position: relative; }
.map-subtitle { font-size: 24rpx; color: #616971; letter-spacing: 1rpx; }
.map-tabs { display: flex; gap: 10rpx; margin-top: 12rpx; padding: 6rpx; border-radius: 60rpx; background: rgba(255,255,255,.88); box-shadow: 0 6rpx 22rpx rgba(57,68,77,.06); }
/* GEO-01 / DESIGN-01: bounded native buttons; compact visuals, 44px touch height. */
.map-page button[size="mini"] { box-sizing: border-box; display: flex; align-items: center; justify-content: center; height: 44px; min-height: 44px; max-height: 44px; white-space: nowrap; }
.map-page .map-tab[size="mini"] { flex: 1; width: 0; min-width: 0; margin: 0; padding: 0; border: 0; border-radius: 0; font-size: 27rpx; font-weight: 500; line-height: 1.3; background: transparent; color: #303238; }
.map-tab-label { display: flex; align-items: center; justify-content: center; width: 100%; height: 36px; border-radius: 48rpx; background: #eeeded; }
.map-page .map-tab.is-active .map-tab-label { background: linear-gradient(125deg,#d43b2c,#b51f18); color: #fff; font-weight: 700; box-shadow: 0 0 0 4rpx #f2d7d1; }
.map-stage { position: relative; }
.map { width: 100%; height: 620rpx; }
.map-tools-left { position: absolute; top: 24rpx; left: 24rpx; }
.map-tool { width: 44px; height: 48px; margin-bottom: 8px; border-radius: 10px; background: #fff; color: #263038; text-align: center; }
.tool-symbol { padding-top: 3px; height: 27px; line-height: 24px; font-size: 25px; }
.tool-label { height: 18px; line-height: 18px; font-size: 10px; }
.tool-active { color: #b5291c; background: #fff5ef; }
.map-tools-right { position: absolute; right: 24rpx; bottom: 64rpx; border-radius: 10px; background: #fff; }
.map-zoom { box-sizing: border-box; width: 44px; height: 44px; line-height: 43px; font-size: 28px; text-align: center; color: #263038; }
.map-zoom + .map-zoom { border-top: 1px solid #eee; }
.tool-disabled { color: #c1c6c9; }
.map-source { position: absolute; right: 24rpx; bottom: 14rpx; padding: 5rpx 8rpx; border-radius: 6rpx; color: #626b70; background: #ffffff; font-size: 19rpx; line-height: 26rpx; }
.map-empty { min-height: 620rpx; display: flex; align-items: center; justify-content: center; flex-direction: column; gap: 12rpx; padding: 30rpx; text-align: center; background: linear-gradient(145deg,#e5ede8,#f1f0e6); color: #747e77; font-size: 23rpx; }
.map-empty-symbol { font-size: 90rpx; color: #789585; line-height: 1.2; }
.map-empty-title { font-size: 30rpx; font-weight: 600; color: #4f675c; }
.map-page .empty-locate[size="mini"] { width: auto; min-width: 112px; max-width: 160px; margin-top: 12rpx; padding: 0 24rpx; background: #fff; font-size: 25rpx; border-radius: 40rpx; color: #77533d; }
.places-panel { position: relative; margin-top: -4rpx; padding: 14rpx 24rpx 26rpx; border-radius: 36rpx 36rpx 0 0; background: #fafbfa; box-shadow: 0 -12rpx 30rpx rgba(42,57,49,.045); }
.panel-handle { width: 48rpx; height: 6rpx; margin: 0 auto 22rpx; border-radius: 9rpx; background: #b7b9ba; }
.places-heading { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.panel-title { display: flex; align-items: center; gap: 13rpx; font-size: 32rpx; font-weight: 700; }
.title-accent { width: 6rpx; height: 26rpx; border-radius: 6rpx; background: #bc2b20; }
.places-count { flex-shrink: 0; color: #929495; font-size: 22rpx; }
.sort-row { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; margin: 6rpx 0 10rpx; }
.sort-tabs { display: flex; gap: 8rpx; }
.map-page .sort-tab[size="mini"] { width: auto; min-width: 72px; margin: 0; padding: 0 16rpx; border-radius: 0; background: transparent; color: #777d81; font-weight: 400; font-size: 25rpx; line-height: 1.4; }
.map-page .sort-tab.is-active { position: relative; color: #bb291e; font-weight: 700; }
.map-page .sort-tab.is-active::after { display: block; position: absolute; bottom: 9px; left: 18rpx; right: 18rpx; top: auto; height: 2px; width: auto; border: 0; border-radius: 2px; background: #bb291e; transform: none; }
.distance-note { flex-shrink: 0; font-size: 19rpx; color: #999d9e; }
.place-card { margin-bottom: 16rpx; padding: 16rpx 16rpx 8rpx; border: 2rpx solid transparent; border-radius: 23rpx; background: #fff; box-shadow: 0 5rpx 20rpx rgba(36,43,41,.025); }
.place-card.is-selected { border-color: #ecd5c8; background: #fffefd; }
.place-main { display: flex; gap: 20rpx; min-width: 0; text-align: left; }
.place-photo { position: relative; overflow: hidden; flex-shrink: 0; width: 172rpx; height: 166rpx; border-radius: 14rpx; background: #eff2ee; }
.place-thumb { display: block; width: 100%; height: 100%; }
.place-photo-empty { height: 100%; display: flex; flex-direction: column; align-items: center; justify-content: center; color: #849589; font-size: 22rpx; background: linear-gradient(130deg,#e6efea,#f5f1e8); }
.photo-symbol { font-size: 58rpx; line-height: 1.2; }
.photo-selected { position: absolute; bottom: 0; left: 0; right: 0; padding: 3rpx 0; text-align: center; color: #fff; background: rgba(139,73,42,.83); font-size: 19rpx; }
.place-copy { flex: 1; min-width: 0; padding-top: 2rpx; }
.place-name { color: #272a29; font-size: 31rpx; line-height: 1.45; font-weight: 700; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: break-word; }
.place-address { margin-top: 7rpx; color: #818387; font-size: 23rpx; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; overflow-wrap: break-word; }
.address-pin { color: #9da1a4; margin-right: 8rpx; font-size: 17rpx; }
.place-distance { color: #63686d; }
.address-divider { padding: 0 5rpx; color: #bfc0c1; }
.place-tags { display: flex; flex-wrap: wrap; gap: 6rpx; margin-top: 10rpx; }
.place-tag { display: block; max-width: 100%; padding: 2rpx 12rpx; border-radius: 24rpx; background: #f6ede3; color: #957354; font-size: 20rpx; line-height: 1.6; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.quest-tag { color: #477c6a; background: #eaf3ee; }
.place-footer { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; margin-top: 6rpx; }
.map-page .place-detail[size="mini"] { width: auto; min-width: 76px; max-width: 120px; margin: 0; padding: 0 6rpx; background: transparent; border-radius: 0; font-size: 23rpx; font-weight: 400; color: #937351; }
.detail-chevron { margin-left: 12rpx; font-size: 34rpx; }
.place-hint { color: #a5a3a0; font-size: 20rpx; }
.map-page .place-navigate[size="mini"] { flex-shrink: 0; width: 164rpx; min-width: 76px; margin: 0; padding: 0; border-radius: 0; background: transparent; color: #fff; font-size: 26rpx; font-weight: 600; line-height: 1.35; }
.navigate-pill { display: flex; align-items: center; justify-content: center; width: 100%; height: 34px; padding: 0 10rpx; border-radius: 60rpx; background: linear-gradient(120deg,#d13625,#b82118); }
.navigate-arrow { margin-right: 8rpx; font-size: 25rpx; }
