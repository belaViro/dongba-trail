/* DESIGN-01: shared paper, ink and cinnabar visual system. */
page { background: #f5f3ee; color: #29333c; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; font-size: 28rpx; line-height: 1.65; }
view, text, button, input, textarea { box-sizing: border-box; }
button { margin: 0; min-height: 44px; display: flex; align-items: center; justify-content: center; padding: 20rpx 28rpx; font-size: 28rpx; font-weight: 600; line-height: 1.5; border-radius: 20rpx; background: #f1e9de; color: #794330; box-shadow: none; }
button::after { border: 0; }
button[disabled], .primary[disabled] { color: #858b90; background: #e8e9e7; box-shadow: none; }
.button-hover { opacity: .78; }
.primary { background: #ad3026; color: #fff; box-shadow: 0 8rpx 20rpx rgba(151, 48, 35, .14); }
.secondary { background: #fffaf3; border: 1rpx solid #e5d8c8; color: #794330; }
.danger { color: #ad3026; }
.link { background: transparent; padding: 12rpx 0; text-align: left; color: #8c4631; font-weight: 500; box-shadow: none; }
.small { padding: 14rpx 20rpx; font-size: 25rpx; border-radius: 16rpx; }
.icon-btn { width: 88rpx; height: 88rpx; padding: 14rpx; border-radius: 50%; font-size: 34rpx; }
.page { padding: 32rpx 28rpx calc(48rpx + env(safe-area-inset-bottom)); }
.section { margin-top: 32rpx; }
.section-head { display: flex; align-items: center; justify-content: space-between; gap: 20rpx; margin-bottom: 22rpx; }
.section-head > view { min-width: 0; }
.section-head > button { flex-shrink: 0; }
.heading { font-size: 34rpx; font-weight: 700; line-height: 1.45; color: #27313b; }
.section-title { display: flex; align-items: center; gap: 14rpx; }
.section-title::before { content: ""; width: 7rpx; height: 28rpx; background: #ad3026; border-radius: 6rpx; flex-shrink: 0; }
.subheading { font-size: 30rpx; font-weight: 600; }
.muted { color: #646c72; font-size: 26rpx; }
.caption { font-size: 24rpx; color: #717579; }
.brand { font-size: 46rpx; font-weight: 700; color: #203246; }
.eyebrow { display: block; color: #99513a; font-size: 20rpx; letter-spacing: 3rpx; margin-bottom: 6rpx; }
.row { display: flex; align-items: center; gap: 20rpx; }
.between { justify-content: space-between; }
.grow { flex: 1; min-width: 0; }
.stack { display: flex; flex-direction: column; gap: 18rpx; }
.actions { display: flex; gap: 16rpx; margin-top: 28rpx; }
.actions > button { flex: 1; min-width: 0; }
.list-row { display: flex; align-items: center; gap: 22rpx; padding: 28rpx 0; border-bottom: 1rpx solid #ece5db; }
.thumb { width: 128rpx; height: 128rpx; border-radius: 16rpx; background: #ece8e0; flex-shrink: 0; }
.cover { display: block; width: 100%; height: 350rpx; border-radius: 22rpx; background: #ece8e0; }
.no-image { display: flex; align-items: center; justify-content: center; color: #79736c; font-size: 24rpx; background: #eee8de; }
.tag { display: inline-block; font-size: 22rpx; color: #865337; background: #f3eadd; padding: 5rpx 14rpx; border-radius: 999rpx; margin: 8rpx 10rpx 0 0; }
.accent { color: #ad3026; }
.body { white-space: pre-wrap; line-height: 1.95; overflow-wrap: anywhere; }
.divider { height: 1rpx; background: #e5ded4; margin: 30rpx 0; }
.bottom-space { padding-bottom: calc(180rpx + env(safe-area-inset-bottom)); }
.bottom-bar { position: fixed; bottom: 0; left: 0; right: 0; z-index: 10; background: #fffdf9; padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom)); display: flex; gap: 16rpx; border-top: 1rpx solid #e8e0d6; box-shadow: 0 -6rpx 24rpx rgba(67, 48, 28, .04); }
.bottom-bar button { flex: 1; min-width: 0; }
.input { background: #fffdf9; border: 1rpx solid #ddd4c7; border-radius: 16rpx; height: 96rpx; padding: 20rpx 24rpx; width: 100%; font-size: 28rpx; color: #29333c; }
.textarea { height: 190rpx; line-height: 1.7; }
.notice { padding: 24rpx; background: #f0f3ed; border-left: 5rpx solid #638575; color: #465f52; font-size: 26rpx; margin: 24rpx 0; border-radius: 0 16rpx 16rpx 0; }
.error-note { background: #fff0eb; border-left-color: #b65340; color: #984333; }
.tabs { display: flex; gap: 12rpx; flex-wrap: wrap; margin: 20rpx 0; }
.tabs button { font-weight: 500; padding: 14rpx 22rpx; font-size: 26rpx; background: #edeae5; color: #646563; box-shadow: none; border: 2rpx solid transparent; }
.tabs .active { background: #ad3026; color: #fff; border-color: #ad3026; font-weight: 700; }
.price { font-size: 32rpx; color: #ad3026; font-weight: 700; }
.page-title { font-size: 44rpx; font-weight: 700; line-height: 1.4; margin-bottom: 10rpx; color: #233449; }
.item-title { font-weight: 600; font-size: 30rpx; overflow-wrap: anywhere; }
.chevron { color: #9a715c; font-size: 38rpx; }
.empty-inline { padding: 34rpx 0; color: #707572; font-size: 26rpx; }
.meta { display: flex; gap: 20rpx; flex-wrap: wrap; margin-top: 12rpx; }
.loading-line { color: #717579; text-align: center; padding: 28rpx; }
.text-wrap { overflow-wrap: anywhere; word-break: break-word; }
.paper-card { padding: 28rpx; border: 1rpx solid #ede4d7; background: #fffdf9; border-radius: 24rpx; box-shadow: 0 10rpx 28rpx rgba(68, 46, 22, .035); }
.stamp { flex-shrink: 0; border: 1rpx solid #ae3a2c; color: #ae3a2c; border-radius: 8rpx; padding: 8rpx 10rpx; font-family: serif; font-size: 22rpx; line-height: 1.15; text-align: center; }
.page-end { margin-top: 40rpx; text-align: center; color: #867a6e; font-size: 22rpx; letter-spacing: 3rpx; }
