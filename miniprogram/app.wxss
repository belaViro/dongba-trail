page{background:#f5f7f6;color:#223c35;font-family:-apple-system,BlinkMacSystemFont,"PingFang SC",sans-serif;font-size:28rpx;line-height:1.65;letter-spacing:0}view,text,button,input,textarea{box-sizing:border-box}button{margin:0;font-size:28rpx;font-weight:600;line-height:1.5;padding:22rpx 28rpx;border-radius:12rpx;background:#e8efeb;color:#176b58}button::after{border:0}button[disabled]{color:#9ba8a1;background:#e8ece9}.primary{background:#176b58;color:#fff}.secondary{background:#fff;border:1rpx solid #c9d5cf}.danger{color:#b63b3b}.link{background:transparent;padding:10rpx 0;text-align:left;color:#176b58;font-weight:500}.small{padding:12rpx 20rpx;font-size:25rpx}.icon-btn{width:76rpx;height:76rpx;padding:12rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:34rpx}.page{padding:32rpx 32rpx 48rpx}.section{margin-top:40rpx}.section-head{display:flex;align-items:center;justify-content:space-between;gap:20rpx;margin-bottom:22rpx}.heading{font-size:36rpx;font-weight:700;line-height:1.4}.subheading{font-size:30rpx;font-weight:650}.muted{color:#738279;font-size:25rpx}.caption{font-size:23rpx;color:#6c7c73}.brand{font-size:44rpx;font-weight:750}.row{display:flex;align-items:center;gap:20rpx}.between{justify-content:space-between}.grow{flex:1;min-width:0}.stack{display:flex;flex-direction:column;gap:18rpx}.actions{display:flex;gap:18rpx;margin-top:28rpx}.actions>button{flex:1;min-width:0}.list-row{display:flex;align-items:center;gap:24rpx;padding:26rpx 0;border-bottom:1rpx solid #e0e7e2}.thumb{width:128rpx;height:128rpx;border-radius:10rpx;background:#e7ede8;flex-shrink:0}.cover{display:block;width:100%;height:350rpx;border-radius:12rpx;background:#e7ede8}.no-image{display:flex;align-items:center;justify-content:center;color:#819088;font-size:23rpx;background:#e9eeeb}.tag{display:inline-block;font-size:22rpx;color:#526a5e;background:#e6eee8;padding:4rpx 14rpx;border-radius:6rpx;margin:8rpx 10rpx 0 0}.accent{color:#a94038}.body{white-space:pre-wrap;line-height:1.95;overflow-wrap:anywhere}.divider{height:1rpx;background:#dfe7e1;margin:30rpx 0}.bottom-space{padding-bottom:160rpx}.bottom-bar{position:fixed;bottom:0;left:0;right:0;z-index:10;background:#fff;padding:18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));display:flex;gap:16rpx;border-top:1rpx solid #e0e7e2}.bottom-bar button{flex:1;min-width:0}.input{background:#fff;border:1rpx solid #d5dfd8;border-radius:10rpx;height:88rpx;padding:18rpx 24rpx;width:100%;font-size:28rpx}.textarea{height:180rpx;line-height:1.7}.notice{padding:22rpx 24rpx;background:#edf3ed;border-left:5rpx solid #83a390;color:#527060;font-size:25rpx;margin:24rpx 0}.error-note{background:#fff0ed;border-left-color:#c27565;color:#994e44}.tabs{display:flex;gap:12rpx;flex-wrap:wrap;margin:20rpx 0}.tabs button{font-weight:500;padding:12rpx 22rpx;font-size:25rpx;background:#e8eee9}.tabs .active{background:#176b58;color:#fff}.price{font-size:32rpx;color:#a54836;font-weight:700}.page-title{font-size:42rpx;font-weight:750;line-height:1.4;margin-bottom:8rpx}.item-title{font-weight:650;font-size:29rpx;overflow-wrap:anywhere}.chevron{color:#8d9c92;font-size:36rpx}.empty-inline{padding:34rpx 0;color:#819087;font-size:26rpx}.meta{display:flex;gap:20rpx;flex-wrap:wrap;margin-top:12rpx}.loading-line{color:#74857b;text-align:center;padding:28rpx}.text-wrap{overflow-wrap:anywhere;word-break:break-word}

