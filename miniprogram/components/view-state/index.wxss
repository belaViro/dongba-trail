.state { box-sizing: border-box; min-height: 260rpx; padding: 44rpx 24rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 20rpx; text-align: center; color: #72736c; font-size: 26rpx; line-height: 1.7; }
.title { font-size: 32rpx; font-weight: 600; color: #584b3c; }
.request { font-size: 22rpx; word-break: break-all; }
.state button { box-sizing: border-box; min-height: 44px; display: flex; align-items: center; justify-content: center; background: #f2e6d6; color: #90482f; font-size: 26rpx; border-radius: 16rpx; padding: 16rpx 34rpx; }
.state button::after { border: 0; }
.loader { width: 34rpx; height: 34rpx; border: 4rpx solid #e5d8c4; border-top-color: #a73529; border-radius: 50%; animation: spin 1s linear infinite; }
@keyframes spin { to { transform: rotate(360deg); } }
