.feature-note{display:flex;align-items:flex-start;gap:14rpx;padding:20rpx 22rpx;margin-top:24rpx;border:1rpx dashed #cdbba3;border-radius:16rpx;background:#f5eee2;color:#75654f;line-height:1.75}
.label{flex-shrink:0;padding:2rpx 12rpx;border-radius:6rpx;background:#eaddc8;color:#765731;font-size:21rpx;font-weight:600}
.detail{flex:1;min-width:0;font-size:23rpx;overflow-wrap:anywhere}
