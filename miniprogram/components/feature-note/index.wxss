.feature-note { display: flex; align-items: flex-start; gap: 14rpx; padding: 22rpx; margin-top: 26rpx; border: 1rpx solid #e6dfd3; border-radius: 16rpx; background: #f1ede5; color: #73695a; line-height: 1.75; }
.label { flex-shrink: 0; max-width: 130rpx; padding: 4rpx 10rpx; border-radius: 6rpx; background: #e6ddcd; color: #765b3d; font-size: 21rpx; font-weight: 600; }
.detail { flex: 1; min-width: 0; font-size: 23rpx; overflow-wrap: anywhere; }
