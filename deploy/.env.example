# Populate deploy/.env locally. Never commit actual secrets or certificate keys.
MYSQL_PASSWORD=CHANGE_ME_GENERATE_RANDOM
MYSQL_ROOT_PASSWORD=CHANGE_ME_GENERATE_DIFFERENT_RANDOM
DONGBA_DATABASE_URL=mysql+pymysql://dongba:URL_ENCODED_MYSQL_PASSWORD@db:3306/dongba?charset=utf8mb4
DONGBA_PUBLIC_BASE_URL=https://your-domain.example
DONGBA_TRUSTED_HOSTS=["your-domain.example","127.0.0.1","localhost"]
DONGBA_WECHAT_APP_ID=
DONGBA_WECHAT_APP_SECRET=
DONGBA_PROVIDER_NAME=unconfigured
DONGBA_PROVIDER_ENDPOINT=
DONGBA_PROVIDER_API_KEY=
DONGBA_PROVIDER_MODEL=
DONGBA_PRIVACY_POLICY_PUBLISHED=false
DONGBA_PRIVACY_CONTACT=
DONGBA_RETENTION_DAYS=30
